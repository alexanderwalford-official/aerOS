gclear(0)
centre(SCREEN_H / 2, "Loading...", DIM, 1)
gshow()
load_sounds()
load_pictures()
if not pictures_ok then
    gclose()
    print("Four Knocks can't find its pictures in " + FOLDER + ": install it with pkg install knocks.")
    exit()
end

warning_screen()
let running = true
while running do
    let start = start_at
    if start == 0 then
        let choice = title_screen()
        if choice == "quit" then
            running = false
        elif choice == "new" then
            saved_level = 0
            intro()
            start = 1
        else
            let progress = load_progress()
            start = progress[0]
            battery = progress[1]
        end
    end
    if running then
        light_on = true
        if demo then
            while demo_step < len(demo_route) and level_of(demo_route[demo_step][1], demo_route[demo_step][2]) < start do
                demo_step = demo_step + 1
            end
            show_fps = true
        end
        if start_at != 0 then start_at = 0 end
        if play_game(start) == "quit" then running = false end
        if demo then running = false end
    end
end

sstop()
gclose()
print("Thanks for playing Four Knocks.")
