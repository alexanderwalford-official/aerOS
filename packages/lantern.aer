# ---------------------------------------------------------------------------
# Small helpers
# ---------------------------------------------------------------------------

func smaller(a, b)
    if a < b then return a end
    return b
end

func bigger(a, b)
    if a > b then return a end
    return b
end

func clamp(x, low, high)
    return bigger(low, smaller(high, x))
end

func sign(x)
    if x > 0 then return 1 end
    if x < 0 then return -1 end
    return 0
end

# The place of `item` in `items`, or -1
func index_of(items, item)
    for i = 0 to len(items) - 1 do
        if items[i] == item then return i end
    end
    return -1
end

# Words broken into lines at most `width` letters long, at spaces (and at every \n)
func wrap_words(words, width)
    let lines = []
    for paragraph in split(words, "\n") do
        let line = ""
        for word in split(paragraph, " ") do
            if line == "" then
                line = word
            elif len(line) + 1 + len(word) <= width then
                line = line + " " + word
            else
                push(lines, line)
                line = word
            end
        end
        push(lines, line)
    end
    return lines
end

# "word" with its first letter a capital
func capital(word)
    if word == "" then return word end
    return upper(sub(word, 0, 1)) + sub(word, 1, len(word) - 1)
end

# Say what just happened, for the tests (which read the serial log, where print() goes), only
# when testing, as print() writes over the picture for a moment
func note_event(words)
    if testing then print(words) end
end

# ---------------------------------------------------------------------------
# Random numbers that come out the same everywhere
# ---------------------------------------------------------------------------
#
# The world must be the same every time for the same seed, so it can't use random() (which
# differs from run to run). This is the "minimal standard" generator of Park and Miller:
# state = state * 16807 mod (2^31 - 1). Multiplying would overflow 32 bits, so it is done with
# Schrage's trick, which splits the sum so that nothing gets bigger than 2^31.

let rng_state = 1

func seed_rng(seed)
    rng_state = seed % 2147483646 + 1
    # the first few numbers from nearby seeds are alike: stir it a little
    for i = 1 to 4 do rnd() end
end

# a number from 1 to 2147483646
func rnd()
    let high = rng_state / 127773
    let low = rng_state % 127773
    rng_state = 16807 * low - 2836 * high
    if rng_state <= 0 then rng_state = rng_state + 2147483647 end
    return rng_state
end

# a whole number from 0 to n - 1
func rint(n)
    return rnd() % n
end

# true `percent` times in a hundred
func chance(percent)
    return rint(100) < percent
end

# one of a list's items
func pick(items)
    return items[rint(len(items))]
end

# Set `flags` to `value` at each of the given places
func mark_all(flags, places, value)
    for p in places do flags[p] = value end
end

# Fill in what each tile is like (see SOLID and the rest above)
func tile_kinds()
    SOLID = list(TILE_COUNT, false)
    FLYOVER = list(TILE_COUNT, false)
    ANIM = list(TILE_COUNT, 0)
    NATURE = list(TILE_COUNT, false)
    mark_all(SOLID, [5, 6, 7, 8, 9, 10, T_TREE, T_PINE, T_BUSH, T_ROCK, T_MOUNT, T_CLIFF,
                     T_DEADTREE, T_BLIGHTTREE, T_ROOFL, T_ROOFR, T_WALLWIN, T_WALLDOOR, T_WINLIT,
                     T_BURNROOF, T_BURNWALL, T_WELL, T_FENCE, T_RUINWALL, T_GATE, T_DWALLTOP,
                     T_DWALL, T_TORCH, T_TORCH + 1, T_SHRINE, T_GRAVE, T_FIRE, T_FIRE + 1,
                     T_LWALLTOP, T_LWALL], true)
    mark_all(FLYOVER, [5, 6, 7, 8, 9, 10, T_BUSH, T_ROCK, T_FENCE, T_GRAVE], true)
    mark_all(NATURE, [T_TREE, T_PINE, T_BUSH, T_ROCK, T_MOUNT, T_CLIFF, T_DEADTREE,
                      T_BLIGHTTREE, T_WATER, T_SHORE], true)
    ANIM[T_WATER] = 3
    ANIM[T_SHORE] = 3
    ANIM[T_TORCH] = 2
    ANIM[T_FIRE] = 2
    # the map's colours, roughly each tile's own
    MAPCOL = list(TILE_COUNT, [79, 154, 63])
    let colours = [[T_GRASS2, 72, 142, 58], [T_FLOWERS, 96, 160, 70], [T_SAND, 232, 207, 143],
                   [T_ROAD, 210, 160, 102], [T_WATER, 62, 92, 154], [T_SHORE, 62, 92, 154],
                   [T_BRIDGE, 156, 106, 60], [T_BRIDGEV, 156, 106, 60], [T_TREE, 46, 107, 58],
                   [T_PINE, 31, 80, 50], [T_BUSH, 60, 130, 60], [T_ROCK, 122, 122, 142],
                   [T_MOUNT, 110, 108, 124], [T_CLIFF, 74, 74, 94], [T_SWAMP, 70, 96, 56],
                   [T_REEDS, 70, 96, 56], [T_DEADTREE, 59, 50, 40], [T_BLIGHT, 70, 50, 84],
                   [T_BLIGHTTREE, 50, 30, 64], [T_ROOFL, 168, 50, 62], [T_ROOFR, 168, 50, 62],
                   [T_WALLWIN, 244, 236, 194], [T_WALLDOOR, 244, 236, 194], [T_BURNROOF, 40, 34, 44],
                   [T_BURNWALL, 40, 34, 44], [T_WELL, 122, 122, 142], [T_FENCE, 156, 106, 60],
                   [T_PLAZA, 150, 150, 165], [T_RUINFL, 140, 140, 150], [T_RUINWALL, 176, 176, 192],
                   [T_CAVE, 20, 16, 26], [T_GATE, 185, 139, 224], [T_GATEOPEN, 185, 139, 224],
                   [T_SHRINE, 158, 230, 240], [T_GRAVE, 176, 176, 192], [T_FIRE, 245, 154, 106],
                   [T_CROPS, 156, 106, 60], [T_DFLOOR, 90, 86, 104], [T_DFLOOR2, 90, 86, 104],
                   [T_DWALLTOP, 30, 24, 36], [T_DWALL, 74, 74, 94], [T_TORCH, 242, 201, 76],
                   [T_STAIRS, 244, 240, 230], [T_LFLOOR, 80, 56, 100], [T_LWALLTOP, 30, 18, 40],
                   [T_LWALL, 75, 42, 107]]
    for c in colours do
        MAPCOL[c[0]] = [c[1], c[2], c[3]]
    end
    for t in [T_WATER, T_SHORE] do
        MAPCOL[t + 1] = MAPCOL[t]
        MAPCOL[t + 2] = MAPCOL[t]
    end
    MAPCOL[T_TORCH + 1] = MAPCOL[T_TORCH]
    MAPCOL[T_FIRE + 1] = MAPCOL[T_FIRE]
    MAPCOL[T_WINLIT] = MAPCOL[T_WALLWIN]
end

func is_water(t)
    return t >= T_WATER and t <= T_SHORE + 2
end

