# desktop: a desktop for aerOS, with windows, a taskbar and a start menu
#
#     pkg install desktop      once, to get it
#     desktop                  start it (Esc closes the front window, then leaves)
#
# What is on it:
#     Clock        the time on a clock face, the date, and this month's calendar
#     Files        the folders and files, from the one you started it in: click to open
#     Viewer       a text file, opened from Files
#     Notes        a notepad, saved as notes.txt in the folder you started it in
#     Calculator   + - * / with decimals
#     System       what aerOS knows about the computer (the same as sysinfo)
#     Settings     the colours, the background picture and where the taskbar goes
#     About        what this is
#     Browser      web pages, with pictures: click links, or type an address (see "The Browser window")
# and, after those, every app installed: the ones that come with aerOS (/bin/) and the
# packages from pkg install (/apps/), found each time the desktop starts.
#
# The mouse: click an icon or the start button (bottom left) to open something, drag a window
# by its title bar, and click its buttons to shrink it to the taskbar (_) or close it (x). The
# power button (bottom right) has Sleep, Restart and Shut down; the start menu has them too.
# Without a mouse: Tab opens the start menu, the arrows choose, Enter opens. The arrows move
# the pointer too, and Enter clicks, so everything can be reached from the keyboard.
#
# The system monitor: little graphics by the clock show what aerOS is doing, live: the
# network's signal bars, how busy the processor is, the threads running, and gauges for the
# memory and the disk cache. Click them (or press Home) for a panel with graphs and numbers.
# See "the system monitor" below.
#
# How it works: everything on the screen is drawn again, back to front (the wallpaper, the
# icons, each window, the taskbar, the menu, then the pointer), into the back buffer (gbuf),
# and shown at once (gshow), so nothing flickers. It is only drawn again when something has
# changed: the mouse moved, a key was pressed, the clock ticked, or the system monitor took
# its look, once a second.
#
# The windows are lists: windows holds them back to front, so the last one is in front. Each
# is [kind, title, x, y, w, h, shrunk, scroll, data], and W_KIND... below say which is which.
#
# Opening an app: aerOS runs one program at a time, so the desktop can't run an app in a
# window of its own. It asks aerOS to launch() the app instead: the desktop closes, the app has
# the screen, and when the app ends aerOS starts the desktop again, with the same windows open
# (their names are handed back to it as its args, "back clock notes"). Notes is saved first.
#
# The settings are kept in desktop.cfg in your home folder, one a line (see save_settings), and
# read each time the desktop starts. aerOS asks before the desktop reads or changes it, as it
# is in your home folder: say A (always) and it won't ask again.


# ---- what the screen looks like -------------------------------------------------------------

# the colour themes, as [name, the wallpaper's top, its bottom, the taskbar, the taskbar's
# buttons, the accent (the start button, today in the calendar), the front window's title bar,
# the others', a chosen row, the start menu, the windows' shadow, the "aerOS" on the wallpaper].
# Ocean is the first, and the one the desktop starts with
let THEMES = [
    ["Ocean",    0x1B3A5C, 0x3E7CB1, 0x1E1E24, 0x34343E, 0xFF7F00, 0x2B5D8C, 0x5A6470, 0xCFE3F7, 0x26262E, 0x0E1A28, 0x5D8FBF],
    ["Forest",   0x1E3B2A, 0x4F8A5B, 0x1B231D, 0x2F3B31, 0xE8B04A, 0x2F6B45, 0x5E6B60, 0xD3EBD5, 0x232B25, 0x0F1E14, 0x7FB38A],
    ["Sunset",   0x3B1E4A, 0xE0784A, 0x24161F, 0x3E2735, 0xFF9E3D, 0x8C3B5E, 0x6E5A66, 0xF7D9E3, 0x2E1C28, 0x1E0E18, 0xF0A070],
    ["Graphite", 0x202226, 0x50545C, 0x141416, 0x2C2C30, 0x4DA3FF, 0x3A3F48, 0x6A6E75, 0xDDE3EA, 0x1E1E22, 0x0A0A0C, 0x80858E]]

# the theme's colours, set by use_theme (these are Ocean's)
let THEME = 0                    # which of THEMES
let SKY_TOP = 0x1B3A5C           # the wallpaper, from the top...
let SKY_BOTTOM = 0x3E7CB1        # ...to the bottom
let TASKBAR = 0x1E1E24
let TASKBAR_LIGHT = 0x34343E
let ACCENT = 0xFF7F00            # aerOS orange
let TITLE_ON = 0x2B5D8C          # the front window's title bar
let TITLE_OFF = 0x5A6470         # the others'
let SELECT = 0xCFE3F7            # a chosen row
let MENU = 0x26262E              # the start menu
let SHADOW = 0x0E1A28
let MARK = 0x5D8FBF              # "aerOS", quietly in the corner of the wallpaper

# the colours every theme shares
let BODY = 0xF2F2EE              # inside a window
let INK = 0x1D1D1B               # text inside a window
let FAINT = 0x8A8A84             # quieter text
let BUTTON_FACE = 0xDCDCD6       # a button in a window
let WHITE_INK = 0xFFFFFF

# the system monitor's colours (see "the system monitor"), the same in every theme: how things
# are going (fine, getting busy, wrong), the network's link, and the dark little screens the
# graphs are drawn on
let GOOD = 0x6BCB77
let BUSY = 0xF2C25C
let BAD = 0xE5534B
let LINK_UP = 0x4FD18B           # the network's signal bars, while the link is up
let SCREEN_BACK = 0x0A0D12       # behind a graph
let MONITOR_EDGE = 0x3C4654      # round the system monitor's panel
let SOFT_INK = 0xA8AEB8          # quieter text on the dark panel

let TASKBAR_H = 34               # pixels: the taskbar along the top or the bottom...
let TASKBAR_SIDE_W = 132         # ...or down the left or the right
let TITLE_H = 24
let BUTTON = 18                  # the _ and x buttons
let ROW = 18                     # one row of text in a list
let MENU_ROW = 28                # one entry of the start menu
let MENU_COLUMN = 200            # the start menu's width (more columns if it doesn't fit)
let CHAR_W = 8                   # text(..., 1) is 8 x 16 pixels a character
let TRAY_W = 124                 # the system monitor's indicators along the taskbar...
let TRAY_UPRIGHT_H = 46          # ...or their height, down a taskbar on the left or the right
let MONITOR_W = 340              # the panel they open
let MONITOR_H = 500

# where the taskbar can go
let SIDES = ["bottom", "top", "left", "right"]
let SIDE_NAMES = ["Bottom", "Top", "Left", "Right"]

# the parts of a window (see the top of this file)
let W_KIND = 0
let W_TITLE = 1
let W_X = 2
let W_Y = 3
let W_W = 4
let W_H = 5
let W_SHRUNK = 6
let W_SCROLL = 7
let W_DATA = 8

# the desktop's own windows, as [kind, name], in the order the icons and the menu show them.
# The apps found on the disk come after them (find_apps)
let OWN_APPS = [["clock", "Clock"], ["files", "Files"], ["notes", "Notes"], ["calc", "Calculator"],
                ["system", "System"], ["settings", "Settings"], ["about", "About"], ["browser", "Browser"]]

# where installed apps are, in the order aerOS looks for one typed at the prompt: the ones that
# come with aerOS, games from an older aerOS, then the packages pkg install puts in /apps/
let APP_FOLDERS = ["/bin/", "/bin/games/", "/apps/"]

let MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August",
              "September", "October", "November", "December"]
let DAYS = ["Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"]


# ---- what is going on -----------------------------------------------------------------------

let SW = 0                       # the screen's size, once it is open
let SH = 0
let APPS = []                    # every icon: [kind, name], and [kind, name, path] for an app
let windows = []
let running = true
let launching = ""               # the app the desktop is closing for, if it is (see the top)
let menu_open = ""               # "start", "power", "monitor" (the system monitor) or "" for none
let menu_choice = 0              # the menu entry the keyboard is on
let dragging = nil               # the window being dragged by its title bar, or nil
let drag_dx = 0                  # where in the title bar it was taken hold of
let drag_dy = 0
let pointer_x = 0
let pointer_y = 0
let has_mouse = true
let buttons_before = 0           # the mouse buttons held last time round
let mouse_x_before = -1          # where the mouse was last time round: the pointer only follows
let mouse_y_before = -1          # it when it moves, so the arrow keys can move the pointer too
let opened = 0                   # windows opened so far, to place each new one a little further on

# where the taskbar is (set by layout), and the rest of the screen, the desk, where the icons
# and the windows go
let TASKBAR_SIDE = "bottom"
let BAR_X = 0
let BAR_Y = 0
let BAR_W = 0
let BAR_H = 0
let DESK_X = 0
let DESK_Y = 0
let DESK_W = 0
let DESK_H = 0

# the background: a BMP picture (its path, and its bytes from rdb), or the theme's colours if ""
let PICTURE = ""
let picture_bytes = nil

# the settings file, in the home folder, and what Settings last said about saving it
let SETTINGS_FILE = ""
let settings_message = ""

# the clock: sysinfo() has the computer's clock as "DD-MM-YY--HH:MM:SS". It is slow to ask
# (it looks at every disk), so it is read once, and time() counts on from there
let clock_known = false
let clock_seconds = 0            # the time of day it said, in seconds
let clock_read_at = 0            # time() when it was read
let day = 1
let month = 1
let year = 2026

# what System shows, kept from the same sysinfo()
let system_rows = []

# The system monitor: what aerOS is doing, from telemetry() once a second (it is quick: it only
# reads counters aerOS keeps anyway). It gives back [ms, idle ms, threads, memory, disk cache,
# network], and T_MS... say which is which; the network's part is [card, running, link,
# address, sent, received, blocked, firewall rules], N_CARD... below (docs/AERLANG.md has it all)
let T_MS = 0
let T_IDLE = 1
let T_THREADS = 2
let T_MEMORY = 3
let T_CACHE = 4
let T_NET = 5
let N_CARD = 0
let N_RUNNING = 1
let N_LINK = 2
let N_ADDRESS = 3
let N_SENT = 4
let N_RECEIVED = 5
let N_BLOCKED = 6
let N_RULES = 7
let THREADS_MAX = 16             # aerOS runs at most 16 threads (src/sys/thread.h)
let LOOK_EVERY = 1000            # milliseconds between looks
let HISTORY = 60                 # looks kept for the graphs: the last minute

let reading = nil                # what telemetry() said last time
let looked_at = 0                # time() then
let cpu_load = 0                 # how busy the processor was since the look before, 0 to 100 (%)
# The graphs' readings, as rings: the newest goes in at history_next, over the oldest, and
# history_next moves on one (back to 0 after the end). So the oldest is always at history_next
let cpu_history = list(HISTORY, 0)
let memory_history = list(HISTORY, 0)
let history_next = 0
let readings = 0                 # how many of the rings' places have a reading yet

# Notes: what has been typed, kept while its window is closed too
let NOTES_FILE = ""
let notes_text = ""
let notes_loaded = false
let notes_changed = false        # typed into since it was last saved
let notes_message = ""


# ---- small helpers --------------------------------------------------------------------------

func inside(x, y, rx, ry, rw, rh)
    # is the point x, y inside the rectangle?
    return x >= rx and x < rx + rw and y >= ry and y < ry + rh
end

func inside_box(x, y, box)
    # the same, for a rectangle as a list [x, y, w, h]
    return inside(x, y, box[0], box[1], box[2], box[3])
end

func fit(s, columns)
    # s cut to fit in this many characters
    if columns <= 0 then
        return ""
    end
    if len(s) > columns then
        return sub(s, 0, columns)
    end
    return s
end

func ends_with(s, ending)
    # does s end with ending, in capitals or not? ("SNAKE.AER" ends with ".aer")
    if len(s) < len(ending) then
        return false
    end
    return lower(sub(s, len(s) - len(ending), len(ending))) == lower(ending)
end

func is_folder(name)
    # la() gives folders with a "/" on the end
    return len(name) > 0 and sub(name, len(name) - 1, 1) == "/"
end

func has(items, x)
    # is x one of the items?
    for item in items do
        if item == x then
            return true
        end
    end
    return false
end

func whole(s)
    # text as a whole number, with any 0s in front taken off first: the clock says "08", and
    # before aerOS 0.01's int() was fixed it read a number starting with 0 as octal (base 8),
    # so int("08") was nil. This keeps the desktop working on an aerOS from before that
    while len(s) > 1 and sub(s, 0, 1) == "0" do
        s = sub(s, 1, len(s) - 1)
    end
    return int(s)
end

func two(n)
    # a number with a 0 in front if it is only one digit: 7 -> "07"
    if n < 10 then
        return "0" + n
    end
    return str(n)
end

func blend(top, bottom, n, total)
    # the colour n / total of the way from top to bottom (each of red, green, blue in turn)
    let r = (top / 65536) % 256
    let g = (top / 256) % 256
    let b = top % 256
    let r2 = (bottom / 65536) % 256
    let g2 = (bottom / 256) % 256
    let b2 = bottom % 256
    return rgb(r + (r2 - r) * n / total, g + (g2 - g) * n / total, b + (b2 - b) * n / total)
end

func wrap(s, columns)
    # the text as lines no longer than columns, breaking long ones at the last space that fits
    # (or at the column, for a word longer than a whole line)
    let lines = []
    if columns < 1 then
        columns = 1
    end
    for part in split(s, chr(10)) do
        # a line from Windows ends in a carriage return as well: leave it off
        if len(part) > 0 and sub(part, len(part) - 1, 1) == chr(13) then
            part = sub(part, 0, len(part) - 1)
        end
        if len(part) == 0 then
            push(lines, "")
        end
        while len(part) > columns do
            # the last space in the part that fits (searching back from the column)
            let cut = columns
            while cut > 0 and sub(part, cut, 1) != " " do
                cut = cut - 1
            end
            if cut == 0 then
                cut = columns   # one long word: break it at the column
            end
            push(lines, sub(part, 0, cut))
            # the next line starts after the space it broke at
            if sub(part, cut, 1) == " " then
                cut = cut + 1
            end
            part = sub(part, cut, len(part) - cut)
        end
        if len(part) > 0 then
            push(lines, part)
        end
    end
    return lines
end


# ---- the clock ------------------------------------------------------------------------------

func read_clock()
    # read the computer's clock and the system rows from sysinfo(), once (see "the clock" above)
    system_rows = sysinfo()
    for row in system_rows do
        if row[1] == "Clock" then
            # "18-11-26--18:39:50": the date, then the time
            let parts = split(row[2], "--")
            if len(parts) == 2 then
                let date = split(parts[0], "-")
                let hms = split(parts[1], ":")
                if len(date) == 3 and len(hms) == 3 then
                    day = whole(date[0])
                    month = whole(date[1])
                    year = 2000 + whole(date[2])
                    clock_seconds = whole(hms[0]) * 3600 + whole(hms[1]) * 60 + whole(hms[2])
                    clock_read_at = time()
                    clock_known = true
                end
            end
        end
    end
end

func now_seconds()
    # the time of day now, in seconds since midnight. After midnight the clock is read again,
    # for the new date
    let seconds = clock_seconds + (time() - clock_read_at) / 1000
    if seconds >= 86400 and clock_known then
        read_clock()
        seconds = clock_seconds
    end
    return seconds % 86400
end

func time_text(with_seconds)
    # the time now as "18:39", or "18:39:50"
    if not clock_known then
        return "--:--"
    end
    let s = now_seconds()
    let shown = two(s / 3600) + ":" + two(s / 60 % 60)
    if with_seconds then
        shown = shown + ":" + two(s % 60)
    end
    return shown
end

func days_in(m, y)
    # how many days month m (1 to 12) of year y has
    if m == 2 then
        if (y % 4 == 0 and y % 100 != 0) or y % 400 == 0 then
            return 29
        end
        return 28
    end
    if m == 4 or m == 6 or m == 9 or m == 11 then
        return 30
    end
    return 31
end

func weekday(d, m, y)
    # the day of the week of a date, 0 Monday to 6 Sunday (Zeller's rule: January and February
    # count as months 13 and 14 of the year before)
    if m < 3 then
        m = m + 12
        y = y - 1
    end
    let h = (d + (13 * (m + 1)) / 5 + y + y / 4 - y / 100 + y / 400) % 7
    # h is 0 for Saturday: turn it round to 0 for Monday
    return (h + 5) % 7
end


# ---- the apps on the disk -------------------------------------------------------------------

func is_app(name)
    # is this file in an app folder an app? A program (.aer), and not the desktop itself.
    # Anything else there (folders, /apps/packages.txt, a package's pictures) isn't. Nor is
    # aerOS's sleep command (/bin/sleep.aer) shown with the apps: Sleep is with the power
    # entries, and does the same without closing the desktop (see go_to_sleep)
    let lowered = lower(name)
    return not is_folder(name) and ends_with(name, ".aer") and lowered != "desktop.aer" and lowered != "sleep.aer"
end

func app_name(file)
    # the name an app is shown with: "maze3d.aer" -> "Maze3d"
    let name = sub(file, 0, len(file) - 4)
    return upper(sub(name, 0, 1)) + lower(sub(name, 1, len(name) - 1))
end

func find_apps()
    # APPS: the desktop's own windows, then every app installed, in the order of their names.
    # The desktop is in /apps/ itself, so it may look in there without asking, and /bin/ is
    # aerOS's own. An app in two folders is the one typing its name would run: the first
    let found = []
    let seen = []
    for folder in APP_FOLDERS do
        let names = la(folder)
        if names != nil then
            for file in names do
                if is_app(file) and not has(seen, lower(file)) then
                    push(seen, lower(file))
                    push(found, ["app", app_name(file), folder + file])
                end
            end
        end
    end
    # in order of their names: each one moves back past the ones after it in the alphabet
    for i = 1 to len(found) - 1 do
        let j = i
        while j > 0 and lower(found[j - 1][1]) > lower(found[j][1]) do
            let swap = found[j]
            found[j] = found[j - 1]
            found[j - 1] = swap
            j = j - 1
        end
    end
    APPS = []
    for app in OWN_APPS do
        push(APPS, app)
    end
    for app in found do
        push(APPS, app)
    end
end

func open_app(app)
    # an icon or a menu entry was picked: the desktop's own window, or an app from the disk
    if app[0] == "app" then
        launch_app(app)
    else
        start_app(app[0])
    end
end

func launch_app(app)
    # close the desktop for an app, coming back to it afterwards (see "Opening an app" at the
    # top). The windows open now are named in what the desktop gets back as its args
    if notes_changed then
        save_notes()
    end
    let back = "back"
    for win in windows do
        if own_kind(win[W_KIND]) then
            back = back + " " + win[W_KIND]
        end
    end
    if launch(app[2], back) then
        launching = app[1]
        running = false
    else
        message("Can't open " + app[1], ["aerOS won't start " + app[2] + ".",
                "Only an app in /bin/ or /apps/ can be opened from here."])
    end
end

func own_kind(kind)
    # is this one of the desktop's own windows (not a viewer, a message or the picture chooser)?
    for app in OWN_APPS do
        if app[0] == kind then
            return true
        end
    end
    return false
end


# ---- turning off, restarting and sleeping ---------------------------------------------------

func power_off(what)
    # "off" or "restart": what OFF and RBT do at the prompt. aerOS asks first itself (power()
    # shows its question over the desktop), and with a yes it never comes back. Notes is saved
    # before it asks, so nothing typed is lost
    if notes_changed then
        save_notes()
    end
    # the desktop without the menu, under aerOS's question
    draw_all()
    power(what)
end

func go_to_sleep()
    # Sleep mode, as aerOS's own sleep command (/bin/sleep.aer) has it: a dark screen, with the
    # processor resting until it is woken. It is done here instead of by launching sleep.aer, so
    # the windows are all still there on waking. sleep() rests the processor between looks at
    # the keyboard and the mouse, ten times a second: a key, a click or moving the mouse wakes it
    let words = "Sleeping. Press a key or move the mouse to wake up."
    rect(0, 0, SW, SH, 0x000000)
    text(SW / 2 - len(words) * CHAR_W / 2, SH / 2 - 8, words, 0x3A3A3A, 1)
    gshow()
    let was = mouse()
    let awake = false
    while not awake do
        sleep(100)
        while haskey() do
            key()
            awake = true
        end
        let now = mouse()
        if now != nil and was != nil then
            if now[0] != was[0] or now[1] != was[1] or now[2] != was[2] then
                awake = true
            end
        end
    end
    # the click that woke it mustn't also click whatever is under the pointer
    let after = mouse()
    if after != nil then
        buttons_before = after[2]
    end
end


# ---- the settings ---------------------------------------------------------------------------

func home_folder()
    # the home folder of whoever is logged in: "/home/tester/" (sysinfo() says who). Without
    # one (aerOS started without its disk), the folder the desktop was started in
    for row in system_rows do
        if row[1] == "User" and row[2] != "" then
            return "/home/" + row[2] + "/"
        end
    end
    return cwd()
end

func use_theme(name)
    # use the colour theme called name; false if there is none
    for i = 0 to len(THEMES) - 1 do
        let t = THEMES[i]
        if lower(t[0]) == lower(name) then
            THEME = i
            SKY_TOP = t[1]
            SKY_BOTTOM = t[2]
            TASKBAR = t[3]
            TASKBAR_LIGHT = t[4]
            ACCENT = t[5]
            TITLE_ON = t[6]
            TITLE_OFF = t[7]
            SELECT = t[8]
            MENU = t[9]
            SHADOW = t[10]
            MARK = t[11]
            return true
        end
    end
    return false
end

func use_picture(path)
    # a BMP for the background, read now and drawn each time (image() takes its bytes).
    # "" for the theme's colours again. False if it isn't a picture aerOS can show
    if path == "" then
        PICTURE = ""
        picture_bytes = nil
        return true
    end
    let bytes = rdb(path)
    if bytes == nil or imgsz(bytes) == nil then
        return false
    end
    PICTURE = path
    picture_bytes = bytes
    return true
end

func load_settings()
    # read desktop.cfg (see save_settings), if there is one. A line it doesn't know is left
    # alone, so a file from a newer desktop still works
    let saved = rdf(SETTINGS_FILE)
    if saved == nil then
        return
    end
    for entry in split(saved, chr(10)) do
        if len(entry) > 0 and sub(entry, len(entry) - 1, 1) == chr(13) then
            entry = sub(entry, 0, len(entry) - 1)
        end
        let equals = find(entry, "=")
        if equals > 0 and sub(entry, 0, 1) != "#" then
            let name = sub(entry, 0, equals)
            let value = sub(entry, equals + 1, len(entry) - equals - 1)
            if name == "theme" then
                use_theme(value)
            elif name == "taskbar" and has(SIDES, value) then
                TASKBAR_SIDE = value
            elif name == "picture" then
                use_picture(value)
            end
        end
    end
end

func save_settings()
    # write desktop.cfg: a line for each setting, name=value. aerOS asks first, the first time
    let nl = chr(10)
    let lines = "# the desktop's settings (desktop.aer): Settings on the desktop changes them" + nl
    lines = lines + "theme=" + THEMES[THEME][0] + nl
    lines = lines + "picture=" + PICTURE + nl
    lines = lines + "taskbar=" + TASKBAR_SIDE + nl
    if wrf(SETTINGS_FILE, lines) then
        settings_message = "Saved in " + SETTINGS_FILE
    else
        settings_message = "Couldn't save " + SETTINGS_FILE
    end
end

func move_taskbar(side)
    # put the taskbar along another side, and keep every window on the desk that is left
    TASKBAR_SIDE = side
    layout()
    for win in windows do
        keep_on_desk(win)
    end
end


# ---- where things go ------------------------------------------------------------------------

func layout()
    # where the taskbar is, along TASKBAR_SIDE, and the desk: the rest of the screen
    if TASKBAR_SIDE == "top" then
        BAR_X = 0
        BAR_Y = 0
        BAR_W = SW
        BAR_H = TASKBAR_H
    elif TASKBAR_SIDE == "left" then
        BAR_X = 0
        BAR_Y = 0
        BAR_W = TASKBAR_SIDE_W
        BAR_H = SH
    elif TASKBAR_SIDE == "right" then
        BAR_X = SW - TASKBAR_SIDE_W
        BAR_Y = 0
        BAR_W = TASKBAR_SIDE_W
        BAR_H = SH
    else
        BAR_X = 0
        BAR_Y = SH - TASKBAR_H
        BAR_W = SW
        BAR_H = TASKBAR_H
    end
    DESK_X = 0
    DESK_Y = 0
    DESK_W = SW
    DESK_H = SH
    if TASKBAR_SIDE == "top" then
        DESK_Y = TASKBAR_H
        DESK_H = SH - TASKBAR_H
    elif TASKBAR_SIDE == "left" then
        DESK_X = TASKBAR_SIDE_W
        DESK_W = SW - TASKBAR_SIDE_W
    elif TASKBAR_SIDE == "right" then
        DESK_W = SW - TASKBAR_SIDE_W
    else
        DESK_H = SH - TASKBAR_H
    end
end

func upright()
    # is the taskbar down one side (left or right), rather than along the top or the bottom?
    return TASKBAR_SIDE == "left" or TASKBAR_SIDE == "right"
end

func start_button()
    # the start button: at the left end of the taskbar, or at the top of it
    if upright() then
        return [BAR_X + 6, BAR_Y + 6, BAR_W - 12, 26]
    end
    return [BAR_X + 6, BAR_Y + 5, 84, BAR_H - 10]
end

func power_button()
    # the power button: at the right end of the taskbar, or at the bottom of it
    if upright() then
        return [BAR_X + 6, BAR_Y + BAR_H - 32, BAR_W - 12, 26]
    end
    return [BAR_X + BAR_W - 36, BAR_Y + 5, 30, BAR_H - 10]
end

func clock_spot()
    # where the time is written on the taskbar: next to the power button
    if upright() then
        return [BAR_X + BAR_W / 2 - 20, BAR_Y + BAR_H - 58]
    end
    return [BAR_X + BAR_W - 96, BAR_Y + 9]
end

func tray_box()
    # the system monitor's indicators, as [x, y, w, h]: just before the clock along the taskbar,
    # or above it down one side
    if upright() then
        return [BAR_X + 6, clock_spot()[1] - 8 - TRAY_UPRIGHT_H, BAR_W - 12, TRAY_UPRIGHT_H]
    end
    return [clock_spot()[0] - 10 - TRAY_W, BAR_Y + 5, TRAY_W, BAR_H - 10]
end

func window_button(i)
    # window i's button on the taskbar, as [x, y, w, h]: 150 pixels apart along the taskbar, or
    # 30 down it, or closer with many windows, so they all fit between the start button and
    # the system monitor's indicators
    let count = len(windows)
    let room = tray_box()[0] - 10 - 100
    let gap = 150
    if upright() then
        room = tray_box()[1] - 6 - (BAR_Y + 40)
        gap = 30
    end
    if count > 0 and room / count < gap then
        gap = room / count
    end
    if upright() then
        return [BAR_X + 6, BAR_Y + 40 + i * gap, BAR_W - 12, gap - 4]
    end
    return [BAR_X + 100 + i * gap, BAR_Y + 5, gap - 6, BAR_H - 10]
end

func keep_on_desk(win)
    # move a window so its title bar is on the desk, where it can be taken hold of
    if win[W_Y] < DESK_Y then
        win[W_Y] = DESK_Y
    end
    if win[W_Y] > DESK_Y + DESK_H - TITLE_H then
        win[W_Y] = DESK_Y + DESK_H - TITLE_H
    end
    if win[W_X] < DESK_X + 60 - win[W_W] then
        win[W_X] = DESK_X + 60 - win[W_W]
    end
    if win[W_X] > DESK_X + DESK_W - 60 then
        win[W_X] = DESK_X + DESK_W - 60
    end
end


# ---- the windows ----------------------------------------------------------------------------

func front()
    # the window in front, or nil if there are none (shrunk ones aren't in front)
    let i = len(windows) - 1
    while i >= 0 do
        if not windows[i][W_SHRUNK] then
            return windows[i]
        end
        i = i - 1
    end
    return nil
end

func to_front(win)
    # move a window to the front (the end of the list), showing it if it was shrunk
    let i = 0
    while i < len(windows) do
        if windows[i] == win then
            remove(windows, i)
        else
            i = i + 1
        end
    end
    win[W_SHRUNK] = false
    push(windows, win)
end

func close(win)
    # take a window away. Notes saves what was typed first, so closing it never loses anything
    if win[W_KIND] == "notes" and notes_changed then
        save_notes()
    end
    let i = 0
    while i < len(windows) do
        if windows[i] == win then
            remove(windows, i)
        else
            i = i + 1
        end
    end
    if dragging == win then
        dragging = nil
    end
end

func find_window(kind)
    # the open window of this kind, or nil
    for win in windows do
        if win[W_KIND] == kind then
            return win
        end
    end
    return nil
end

func open(kind, title, w, h, data)
    # open a new window on the desk, right of the icons, a little further on from the last
    # one, in front
    let icon_columns = (len(APPS) + icon_rows() - 1) / icon_rows()
    let x = DESK_X + 30 + icon_columns * 92 + (opened % 8) * 34
    let y = DESK_Y + 30 + (opened % 8) * 28
    opened = opened + 1
    # keep it on the desk
    if x + w > DESK_X + DESK_W then
        x = DESK_X + DESK_W - w - 10
    end
    if y + h > DESK_Y + DESK_H then
        y = DESK_Y + DESK_H - h - 10
    end
    if x < DESK_X then
        x = DESK_X
    end
    if y < DESK_Y then
        y = DESK_Y
    end
    let win = [kind, title, x, y, w, h, false, 0, data]
    push(windows, win)
    return win
end

func message(title, lines)
    # a small window saying something, such as why an app couldn't be opened
    open("message", title, 480, 110, lines)
end

func start_app(kind)
    # open one of the desktop's own windows, or bring it to the front if it is open already
    let have = find_window(kind)
    if have != nil then
        to_front(have)
        return
    end
    if kind == "clock" then
        open("clock", "Clock", 460, 330, [])
    elif kind == "files" then
        # [the folder, what is in it, the row chosen with the keyboard]
        open("files", "Files", 420, 400, [cwd(), list_folder(cwd(), false), 0])
    elif kind == "notes" then
        load_notes()
        open("notes", "Notes - " + NOTES_FILE, 460, 340, [])
    elif kind == "calc" then
        # [what the display shows, the number before the operator, the operator, start afresh?]
        open("calc", "Calculator", 232, 300, ["0", nil, "", true])
    elif kind == "system" then
        # read it again, so it is as things are now (and the clock with it)
        read_clock()
        open("system", "System", 520, 400, [])
    elif kind == "settings" then
        # [the row chosen with the keyboard]
        settings_message = ""
        open("settings", "Settings", 490, 290, [0])
    elif kind == "about" then
        open("about", "About", 380, 230, [])
    elif kind == "browser" then
        open_browser()
    end
end


# ---- Files, the viewer and the picture chooser ----------------------------------------------

func list_folder(folder, pictures)
    # what is in a folder, folders first (they end in "/"), with "../" to go up unless it is "/".
    # pictures: only the BMP pictures, for choosing a background. nil if it can't be read
    # (aerOS asks first, for a folder that isn't its own: a no is nil)
    let names = la(folder)
    if names == nil then
        return nil
    end
    let folders = []
    let files = []
    if folder != "/" then
        push(folders, "../")
    end
    for name in names do
        if is_folder(name) then
            push(folders, name)
        elif not pictures or ends_with(name, ".bmp") then
            push(files, name)
        end
    end
    return folders + files
end

func parent(folder)
    # the folder a folder is in: "/home/alex/" -> "/home/"
    let parts = split(folder, "/")
    let up = "/"
    # the parts are "", "home", "alex", "" for "/home/alex/": all but the last name
    for i = 1 to len(parts) - 3 do
        up = up + parts[i] + "/"
    end
    return up
end

func open_entry(win, name)
    # a row of Files (or the picture chooser) was clicked: go into a folder, or open the file:
    # in a viewer, or as the background
    let folder = win[W_DATA][0]
    let pictures = win[W_KIND] == "pick"
    if name == "../" then
        let up = parent(folder)
        let names = list_folder(up, pictures)
        if names != nil then
            win[W_DATA] = [up, names, 0]
            win[W_SCROLL] = 0
        end
    elif is_folder(name) then
        let names = list_folder(folder + name, pictures)
        if names != nil then
            win[W_DATA] = [folder + name, names, 0]
            win[W_SCROLL] = 0
        end
    elif pictures then
        if use_picture(folder + name) then
            save_settings()
            close(win)
        else
            message("Not a picture", [name + " isn't a BMP picture aerOS can show."])
        end
    else
        open_viewer(folder + name)
    end
end

func choose_picture()
    # the picture chooser: Files, showing only folders and BMP pictures, from the home folder
    let have = find_window("pick")
    if have != nil then
        to_front(have)
        return
    end
    let folder = home_folder()
    open("pick", "Choose a background picture", 420, 400, [folder, list_folder(folder, true), 0])
end

func open_viewer(path)
    # a viewer window for one file's text
    let contents = rdf(path)
    let lines = []
    if contents == nil then
        lines = ["(this file couldn't be read)"]
    else
        lines = wrap(contents, (560 - 28) / CHAR_W)
    end
    open("view", path, 560, 420, lines)
end


# ---- Notes ----------------------------------------------------------------------------------

func load_notes()
    # read notes.txt the first time Notes is opened (there may not be one yet)
    if notes_loaded then
        return
    end
    notes_loaded = true
    let saved = rdf(NOTES_FILE)
    if saved != nil then
        notes_text = saved
    end
end

func save_notes()
    # write what has been typed to notes.txt (aerOS asks first, the first time)
    if wrf(NOTES_FILE, notes_text) then
        notes_message = "Saved at " + time_text(false)
        notes_changed = false
    else
        notes_message = "Couldn't save it"
    end
end

func notes_key(k)
    # a key typed into Notes
    if k == KEY_BACKSPACE then
        if len(notes_text) > 0 then
            notes_text = sub(notes_text, 0, len(notes_text) - 1)
        end
    elif k == KEY_ENTER then
        notes_text = notes_text + chr(10)
    elif k == KEY_TAB then
        notes_text = notes_text + "    "
    elif k >= 32 and k < 127 then
        notes_text = notes_text + chr(k)
    end
    notes_message = ""
    notes_changed = true
end


# ---- the calculator -------------------------------------------------------------------------

let CALC_KEYS = [["7", "8", "9", "/"], ["4", "5", "6", "*"], ["1", "2", "3", "-"],
                 ["0", ".", "=", "+"], ["C"]]

func number_of(s)
    # the display's text as a number: whole, or decimal if it has a point
    if find(s, ".") >= 0 then
        return float(s)
    end
    return int(s)
end

func work_out(a, op, b)
    # a op b, or nil if it can't be done (dividing by 0)
    if op == "+" then
        return a + b
    elif op == "-" then
        return a - b
    elif op == "*" then
        return a * b
    elif op == "/" then
        if b == 0 then
            return nil
        end
        # a whole answer stays whole only if it really is: 7 / 2 is 3.5 here
        return float(a) / b
    end
    return b
end

func calc_press(win, label)
    # one of the calculator's keys
    let state = win[W_DATA]
    let shown = state[0]
    if label == "C" then
        win[W_DATA] = ["0", nil, "", true]
    elif label == "." then
        if state[3] then
            shown = "0."
        elif find(shown, ".") < 0 then
            shown = shown + "."
        end
        win[W_DATA] = [shown, state[1], state[2], false]
    elif find("0123456789", label) >= 0 then
        if state[3] or shown == "0" then
            shown = label
        elif len(shown) < 16 then
            shown = shown + label
        end
        win[W_DATA] = [shown, state[1], state[2], false]
    else
        # + - * / or =: finish the sum waiting, if there is one
        let value = number_of(shown)
        if value == nil then
            value = 0
        end
        if state[1] != nil and state[2] != "" and not state[3] then
            value = work_out(state[1], state[2], value)
        end
        if value == nil then
            win[W_DATA] = ["can't divide by 0", nil, "", true]
            return
        end
        if label == "=" then
            win[W_DATA] = [str(value), nil, "", true]
        else
            win[W_DATA] = [str(value), value, label, true]
        end
    end
end

func calc_key(win, k)
    # a key typed while the calculator is in front: the same as clicking its key
    if k == KEY_ENTER then
        calc_press(win, "=")
    elif k == KEY_BACKSPACE then
        calc_press(win, "C")
    elif k > 0 and k < 127 then
        let label = chr(k)
        if find("0123456789.+-*/=", label) >= 0 then
            calc_press(win, label)
        elif label == "c" or label == "C" then
            calc_press(win, "C")
        end
    end
end


# ---- Settings -------------------------------------------------------------------------------

# Settings has three rows of buttons: the colours (a button for each theme), the background
# (the theme's colours, or a picture) and where the taskbar goes. Clicking a button changes it
# and saves it straight away. From the keyboard: Up and Down choose a row, Left and Right
# change it, and Enter opens the picture chooser

func settings_buttons(x, y)
    # every button in Settings, as [row, which, label, x, y, w, h], for the window's inside
    # at x, y
    let buttons = []
    for i = 0 to len(THEMES) - 1 do
        push(buttons, [0, i, THEMES[i][0], x + 120 + i * 88, y + 16, 82, 24])
    end
    push(buttons, [1, 0, "Colours", x + 120, y + 66, 82, 24])
    push(buttons, [1, 1, "Picture...", x + 208, y + 66, 104, 24])
    for i = 0 to len(SIDES) - 1 do
        push(buttons, [2, i, SIDE_NAMES[i], x + 120 + i * 76, y + 136, 70, 24])
    end
    return buttons
end

func setting_is(row, which)
    # is this button the setting as it is now? (it is drawn pressed in)
    if row == 0 then
        return which == THEME
    elif row == 1 then
        return (which == 1) == (PICTURE != "")
    end
    return SIDES[which] == TASKBAR_SIDE
end

func change_setting(row, which)
    # a button in Settings was pressed: change that setting, and save them all
    if row == 0 then
        use_theme(THEMES[which][0])
    elif row == 1 and which == 0 then
        use_picture("")
    elif row == 1 then
        # the picture is saved once one has been chosen
        choose_picture()
        return
    else
        move_taskbar(SIDES[which])
    end
    save_settings()
end

func settings_key(win, k)
    # Up and Down choose a row, Left and Right change it, Enter opens the picture chooser.
    # True if the key was one of those
    let row = win[W_DATA][0]
    if k == KEY_UP then
        win[W_DATA][0] = (row + 2) % 3
    elif k == KEY_DOWN then
        win[W_DATA][0] = (row + 1) % 3
    elif k == KEY_LEFT or k == KEY_RIGHT then
        let by = 1
        if k == KEY_LEFT then
            by = -1
        end
        if row == 0 then
            change_setting(0, (THEME + by + len(THEMES)) % len(THEMES))
        elif row == 1 then
            change_setting(1, (by + 1) / 2)
        else
            let side = 0
            for i = 0 to len(SIDES) - 1 do
                if SIDES[i] == TASKBAR_SIDE then
                    side = i
                end
            end
            change_setting(2, (side + by + len(SIDES)) % len(SIDES))
        end
    elif k == KEY_ENTER and row == 1 then
        choose_picture()
    else
        return false
    end
    return true
end

func draw_settings(win, x, y, w, h)
    # the three rows of buttons, what the background is, and whether it was saved
    let labels = ["Colours", "Background", "Taskbar"]
    let row_y = [y + 20, y + 70, y + 140]
    for r = 0 to 2 do
        let colour = INK
        if r == win[W_DATA][0] and win == front() then
            colour = TITLE_ON
            text(x + 6, row_y[r], ">", colour, 1)
        end
        text(x + 18, row_y[r], labels[r], colour, 1)
    end
    for b in settings_buttons(x, y) do
        let face = BUTTON_FACE
        let ink = INK
        if setting_is(b[0], b[1]) then
            face = TITLE_ON
            ink = WHITE_INK
        elif inside(pointer_x, pointer_y, b[3], b[4], b[5], b[6]) then
            face = 0xFFFFFF
        end
        rect(b[3], b[4], b[5], b[6], face)
        # each theme's button has a strip of its own wallpaper colour along the bottom
        if b[0] == 0 then
            rect(b[3], b[4] + b[6] - 4, b[5], 4, THEMES[b[1]][2])
        end
        text(b[3] + b[5] / 2 - len(b[2]) * CHAR_W / 2, b[4] + 4, b[2], ink, 1)
    end
    let showing = "The theme's colours"
    if PICTURE != "" then
        showing = PICTURE
    end
    text(x + 120, y + 98, fit(showing, (w - 130) / CHAR_W), FAINT, 1)
    text(x + 18, y + 184, fit(settings_message, (w - 28) / CHAR_W), INK, 1)
    text(x + 18, y + 214, "Up and Down choose a row, Left and Right change it.", FAINT, 1)
    text(x + 18, y + 232, "They are kept in " + fit(SETTINGS_FILE, (w - 180) / CHAR_W), FAINT, 1)
end

func click_settings(win, px, py)
    # a click inside Settings: on one of its buttons?
    let buttons = settings_buttons(win[W_X], win[W_Y] + TITLE_H)
    for b in buttons do
        if inside(px, py, b[3], b[4], b[5], b[6]) then
            win[W_DATA][0] = b[0]
            change_setting(b[0], b[1])
            return
        end
    end
end


# ---- drawing --------------------------------------------------------------------------------

func draw_wallpaper()
    # the theme's sky over the desk, darker at the top, in bands, and the picture over it if
    # there is one: as big as fits on the desk, keeping its shape, in the middle
    let bands = 24
    let band = DESK_H / bands + 1
    for i = 0 to bands - 1 do
        rect(DESK_X, DESK_Y + i * band, DESK_W, band, blend(SKY_TOP, SKY_BOTTOM, i, bands - 1))
    end
    if picture_bytes == nil then
        # the name, quietly, in the corner
        text(DESK_X + DESK_W - 150, DESK_Y + DESK_H - 40, "aerOS", MARK, 3)
        return
    end
    # the size image() will draw it at (it fits it in the box the same way), to put it in the
    # middle: the narrower shape fills the height, the wider the width
    let size = imgsz(picture_bytes)
    let w = DESK_W
    let h = DESK_H
    if size[0] * DESK_H <= size[1] * DESK_W then
        w = size[0] * DESK_H / size[1]
    else
        h = size[1] * DESK_W / size[0]
    end
    image(picture_bytes, DESK_X + (DESK_W - w) / 2, DESK_Y + (DESK_H - h) / 2, w, h)
end

func draw_icon(app, x, y)
    # a small picture for each app, 48 x 40, drawn with rectangles and lines
    let kind = app[0]
    if kind == "clock" then
        rect(x + 8, y, 32, 32, 0xEDEDED)
        rect(x + 10, y + 2, 28, 28, 0xFFFFFF)
        line(x + 24, y + 16, x + 24, y + 6, INK)
        line(x + 24, y + 16, x + 32, y + 16, ACCENT)
    elif kind == "files" then
        rect(x + 4, y + 4, 18, 6, 0xE8B04A)
        rect(x + 4, y + 8, 40, 26, 0xF2C25C)
    elif kind == "notes" then
        rect(x + 10, y, 28, 34, 0xFFF6B3)
        for i = 0 to 3 do
            rect(x + 14, y + 8 + i * 6, 20, 2, 0xB7AE6A)
        end
    elif kind == "calc" then
        rect(x + 10, y, 28, 34, 0x444A55)
        rect(x + 13, y + 3, 22, 8, 0xBFE6C0)
        for i = 0 to 2 do
            for j = 0 to 2 do
                rect(x + 13 + j * 8, y + 14 + i * 6, 6, 4, 0xDDDDDD)
            end
        end
    elif kind == "system" then
        rect(x + 4, y + 2, 40, 26, 0x2A2F38)
        rect(x + 7, y + 5, 34, 20, 0x4DA3FF)
        rect(x + 18, y + 28, 12, 4, 0x2A2F38)
        rect(x + 12, y + 32, 24, 3, 0x2A2F38)
    elif kind == "settings" then
        # three sliders
        rect(x + 8, y + 2, 32, 32, 0x3A3F48)
        for i = 0 to 2 do
            rect(x + 12, y + 8 + i * 9, 24, 2, 0xBFC5CC)
            rect(x + 14 + ((i * 9 + 5) % 18), y + 5 + i * 9, 6, 8, ACCENT)
        end
    elif kind == "about" then
        rect(x + 8, y, 32, 32, ACCENT)
        text(x + 20, y + 8, "i", WHITE_INK, 1)
    elif kind == "browser" then
        # a globe in a little window
        rect(x + 4, y + 2, 40, 30, 0x2A2F38)
        rect(x + 4, y + 2, 40, 6, 0x4DA3FF)
        draw_disc(x + 24, y + 20, 10, 0x6BA8E0)
        line(x + 14, y + 20, x + 34, y + 20, 0xFFFFFF)
        line(x + 24, y + 10, x + 24, y + 30, 0xFFFFFF)
    elif kind == "app" then
        # an app from the disk: a little window with its first letter, its title bar orange for
        # a package (/apps/) and grey for one that comes with aerOS (/bin/)
        rect(x + 6, y + 2, 36, 30, 0x2A2F38)
        rect(x + 6, y + 2, 36, 8, app_colour(app))
        text(x + 20, y + 13, upper(sub(app[1], 0, 1)), WHITE_INK, 1)
    end
end

func app_colour(app)
    # the colour an app from the disk is marked with: a package's, or one of aerOS's own
    if sub(app[2], 0, 6) == "/apps/" then
        return ACCENT
    end
    return 0x8A96A3
end

func icon_rows()
    # how many icons fit down the desk, before they start another column
    let rows = (DESK_H - 24) / 78
    if rows < 1 then
        rows = 1
    end
    return rows
end

func icon_at(i)
    # where icon i is: [x, y] of its top left. They go down the left of the desk, and on into
    # more columns when there are more than fit
    let rows = icon_rows()
    return [DESK_X + 26 + (i / rows) * 92, DESK_Y + 24 + (i % rows) * 78]
end

func draw_icons()
    # the apps down the left of the desk, each with its name under it
    for i = 0 to len(APPS) - 1 do
        let spot = icon_at(i)
        draw_icon(APPS[i], spot[0], spot[1])
        let name = fit(APPS[i][1], 11)
        text(spot[0] + 24 - len(name) * 4, spot[1] + 42, name, WHITE_INK, 1)
    end
end

func draw_window(win, is_front)
    # one window: its shadow, title bar and buttons, then what is in it
    let x = win[W_X]
    let y = win[W_Y]
    let w = win[W_W]
    let h = win[W_H]
    rect(x + 5, y + 5, w, h, SHADOW)
    rect(x - 1, y - 1, w + 2, h + 2, 0x101014)
    let bar = TITLE_OFF
    if is_front then
        bar = TITLE_ON
    end
    rect(x, y, w, TITLE_H, bar)
    let heading = win[W_TITLE]
    if win[W_KIND] == "browser" then
        heading = wb_window_title()
    end
    text(x + 8, y + 4, fit(heading, (w - 60) / CHAR_W), WHITE_INK, 1)
    # _ shrinks it to the taskbar, x closes it
    rect(x + w - 2 * BUTTON - 6, y + 3, BUTTON, BUTTON, 0x6F7C8A)
    text(x + w - 2 * BUTTON - 2, y + 4, "_", WHITE_INK, 1)
    rect(x + w - BUTTON - 3, y + 3, BUTTON, BUTTON, 0xC0392B)
    text(x + w - BUTTON + 2, y + 4, "x", WHITE_INK, 1)
    rect(x, y + TITLE_H, w, h - TITLE_H, BODY)
    draw_content(win, x, y + TITLE_H, w, h - TITLE_H)
end

func draw_content(win, x, y, w, h)
    # what is inside a window, by its kind
    let kind = win[W_KIND]
    if kind == "clock" then
        draw_clock(x, y, w, h)
    elif kind == "files" or kind == "pick" then
        draw_files(win, x, y, w, h)
    elif kind == "view" or kind == "message" then
        draw_lines(win[W_DATA], win[W_SCROLL], x, y, w, h)
    elif kind == "notes" then
        draw_notes(x, y, w, h)
    elif kind == "calc" then
        draw_calc(win, x, y, w, h)
    elif kind == "system" then
        draw_system(win, x, y, w, h)
    elif kind == "settings" then
        draw_settings(win, x, y, w, h)
    elif kind == "about" then
        draw_about(x, y)
    elif kind == "browser" then
        wb_draw(win)
    end
end

func rows_fit(h)
    # how many list rows fit in a window's inside, h pixels tall
    return (h - 12) / ROW
end

func draw_scrollbar(first, shown, total, x, y, h)
    # a thin bar down the right edge, showing which part of a long list is in view
    if total <= shown then
        return
    end
    rect(x, y + 4, 6, h - 8, 0xDDDDD8)
    let top = (h - 8) * first / total
    let size = (h - 8) * shown / total
    if size < 10 then
        size = 10
    end
    rect(x, y + 4 + top, 6, size, 0x9AA3AD)
end

func draw_lines(lines, first, x, y, w, h)
    # lines of text, from line `first`, as many as fit
    let shown = rows_fit(h)
    let columns = (w - 28) / CHAR_W
    for i = 0 to shown - 1 do
        let n = first + i
        if n < len(lines) then
            text(x + 10, y + 6 + i * ROW, fit(lines[n], columns), INK, 1)
        end
    end
    draw_scrollbar(first, shown, len(lines), x + w - 10, y, h)
end

func draw_files(win, x, y, w, h)
    # the folder's name, then a row for each thing in it
    let folder = win[W_DATA][0]
    let names = win[W_DATA][1]
    rect(x, y, w, ROW + 6, 0xE4E4DE)
    text(x + 10, y + 4, fit(folder, (w - 20) / CHAR_W), FAINT, 1)
    if names == nil then
        text(x + 10, y + ROW + 12, "This folder can't be read.", INK, 1)
        return
    end
    let top = y + ROW + 6
    let shown = rows_fit(h - ROW - 6)
    for i = 0 to shown - 1 do
        let n = win[W_SCROLL] + i
        if n < len(names) then
            let name = names[n]
            let row_y = top + 6 + i * ROW
            let hovered = inside(pointer_x, pointer_y, x, row_y - 1, w - 12, ROW) and win == front()
            if hovered or (n == win[W_DATA][2] and win == front()) then
                rect(x + 4, row_y - 1, w - 18, ROW, SELECT)
            end
            # a folder gets a little yellow tab, a file a white page
            if is_folder(name) then
                rect(x + 10, row_y + 2, 14, 11, 0xF2C25C)
            else
                rect(x + 12, row_y + 1, 10, 13, 0xFFFFFF)
                rect(x + 12, row_y + 1, 10, 1, FAINT)
            end
            text(x + 32, row_y, fit(name, (w - 50) / CHAR_W), INK, 1)
        end
    end
    draw_scrollbar(win[W_SCROLL], shown, len(names), x + w - 10, top, h - ROW - 6)
end

func draw_clock(x, y, w, h)
    # the clock face on the left, the time, the date and the month on the right
    let cx = x + 120
    let cy = y + h / 2
    let radius = 96
    # the face: a ring of short lines, longer every 5 minutes
    for i = 0 to 59 do
        let angle = i * PI / 30
        let inner = radius - 6
        if i % 5 == 0 then
            inner = radius - 14
        end
        line(cx + floor(sin(angle) * inner), cy - floor(cos(angle) * inner),
             cx + floor(sin(angle) * radius), cy - floor(cos(angle) * radius), INK)
    end
    if not clock_known then
        text(x + 250, y + 30, "No clock found", INK, 1)
        return
    end
    let s = now_seconds()
    # the hands, from the centre: hours (short), minutes, seconds (thin, orange)
    hand(cx, cy, (s % 43200) * 2 * PI / 43200, 52, INK, 3)
    hand(cx, cy, (s % 3600) * 2 * PI / 3600, 78, INK, 2)
    hand(cx, cy, (s % 60) * 2 * PI / 60, 86, ACCENT, 1)
    rect(cx - 3, cy - 3, 7, 7, ACCENT)

    # the time and the date
    text(x + 250, y + 14, time_text(true), INK, 2)
    text(x + 250, y + 50, str(day) + " " + MONTHS[month - 1] + " " + year, FAINT, 1)

    # this month: a row of day names, then the weeks, today in orange
    let gx = x + 250
    let gy = y + 84
    for i = 0 to 6 do
        text(gx + i * 28, gy, DAYS[i], FAINT, 1)
    end
    let first = weekday(1, month, year)
    for d = 1 to days_in(month, year) do
        let place = first + d - 1
        let dx = gx + (place % 7) * 28
        let dy = gy + 22 + (place / 7) * 20
        if d == day then
            rect(dx - 3, dy - 1, 24, 18, ACCENT)
            text(dx, dy, two(d), WHITE_INK, 1)
        else
            text(dx, dy, two(d), INK, 1)
        end
    end
end

func hand(cx, cy, angle, length, colour, thickness)
    # one of the clock's hands: a line from the centre, drawn `thickness` times side by side
    let ex = cx + floor(sin(angle) * length)
    let ey = cy - floor(cos(angle) * length)
    for t = 0 to thickness - 1 do
        line(cx + t, cy, ex + t, ey, colour)
        line(cx, cy + t, ex, ey + t, colour)
    end
end

func draw_notes(x, y, w, h)
    # what has been typed, the last part of it if it doesn't all fit, and the Save button
    rect(x, y, w, ROW + 10, 0xE4E4DE)
    rect(x + 8, y + 4, 60, ROW, TITLE_ON)
    text(x + 18, y + 5, "Save", WHITE_INK, 1)
    text(x + 80, y + 5, notes_message, FAINT, 1)
    let lines = wrap(notes_text, (w - 28) / CHAR_W)
    let shown = rows_fit(h - ROW - 10)
    let first = len(lines) - shown
    if first < 0 then
        first = 0
    end
    draw_lines(lines, first, x, y + ROW + 10, w, h - ROW - 10)
    # the cursor: after the last character
    let last = len(lines) - 1
    let cursor_row = last - first
    let cursor_x = x + 10 + len(lines[last]) * CHAR_W
    if time() / 500 % 2 == 0 then
        rect(cursor_x, y + ROW + 16 + cursor_row * ROW, 2, 15, INK)
    end
end

func draw_calc(win, x, y, w, h)
    # the display, and the keys in a grid
    rect(x + 10, y + 10, w - 20, 40, 0x2A2F38)
    let shown = win[W_DATA][0]
    text(x + w - 18 - len(shown) * 2 * CHAR_W, y + 18, shown, 0xBFE6C0, 2)
    for r = 0 to len(CALC_KEYS) - 1 do
        let keys = CALC_KEYS[r]
        for c = 0 to len(keys) - 1 do
            let kx = x + 10 + c * 53
            let ky = y + 60 + r * 42
            let kw = 48
            if len(keys) == 1 then
                kw = w - 20     # C is the whole row
            end
            let colour = BUTTON_FACE
            if find("/*-+=", keys[c]) >= 0 then
                colour = 0xF3C27A
            end
            if inside(pointer_x, pointer_y, kx, ky, kw, 36) then
                colour = 0xFFFFFF
            end
            rect(kx, ky, kw, 36, colour)
            text(kx + kw / 2 - 8, ky + 10, keys[c], INK, 2)
        end
    end
end

func calc_key_at(win, px, py)
    # the calculator key under px, py, or nil
    let x = win[W_X]
    let y = win[W_Y] + TITLE_H
    let w = win[W_W]
    for r = 0 to len(CALC_KEYS) - 1 do
        let keys = CALC_KEYS[r]
        for c = 0 to len(keys) - 1 do
            let kw = 48
            if len(keys) == 1 then
                kw = w - 20
            end
            if inside(px, py, x + 10 + c * 53, y + 60 + r * 42, kw, 36) then
                return keys[c]
            end
        end
    end
    return nil
end

func draw_system(win, x, y, w, h)
    # sysinfo()'s rows: each group's name, then its rows
    let lines = []
    let group = ""
    for row in system_rows do
        if row[0] != group then
            group = row[0]
            if len(lines) > 0 then
                push(lines, "")
            end
            push(lines, "[ " + group + " ]")
        end
        push(lines, "  " + row[1] + ": " + row[2])
    end
    draw_lines(lines, win[W_SCROLL], x, y, w, h)
end

func draw_about(x, y)
    # who and what
    text(x + 20, y + 16, "aerOS desktop", ACCENT, 2)
    text(x + 20, y + 56, "A desktop with windows, written in AerLang.", INK, 1)
    text(x + 20, y + 76, "It is a package: pkg install desktop", INK, 1)
    text(x + 20, y + 106, "Drag a window by its title bar.", FAINT, 1)
    text(x + 20, y + 124, "Tab opens the menu, Esc closes the front window.", FAINT, 1)
    text(x + 20, y + 142, "Home shows the system monitor.", FAINT, 1)
    text(x + 20, y + 160, "Read it: /apps/desktop.aer", FAINT, 1)
end

func draw_power_sign(cx, cy, colour)
    # the power sign, around cx, cy: a ring open at the top, with a line down into it
    let r = 7
    for i = 1 to 10 do
        let a = i * PI / 6
        let b = (i + 1) * PI / 6
        line(cx + floor(sin(a) * r), cy - floor(cos(a) * r), cx + floor(sin(b) * r), cy - floor(cos(b) * r), colour)
    end
    line(cx, cy - 9, cx, cy - 1, colour)
end

func draw_taskbar()
    # the start button, a button for each window, the clock and the power button
    rect(BAR_X, BAR_Y, BAR_W, BAR_H, TASKBAR)
    # a light edge on the side next to the desk
    if TASKBAR_SIDE == "top" then
        rect(BAR_X, BAR_Y + BAR_H - 1, BAR_W, 1, TASKBAR_LIGHT)
    elif TASKBAR_SIDE == "left" then
        rect(BAR_X + BAR_W - 1, BAR_Y, 1, BAR_H, TASKBAR_LIGHT)
    elif TASKBAR_SIDE == "right" then
        rect(BAR_X, BAR_Y, 1, BAR_H, TASKBAR_LIGHT)
    else
        rect(BAR_X, BAR_Y, BAR_W, 1, TASKBAR_LIGHT)
    end
    let start = start_button()
    let start_colour = ACCENT
    if menu_open == "start" then
        start_colour = blend(ACCENT, 0xFFFFFF, 1, 4)
    end
    rect(start[0], start[1], start[2], start[3], start_colour)
    text(start[0] + start[2] / 2 - 20, start[1] + start[3] / 2 - 8, "aerOS", WHITE_INK, 1)

    let top = front()
    for i = 0 to len(windows) - 1 do
        let win = windows[i]
        let b = window_button(i)
        let colour = TASKBAR_LIGHT
        if win == top then
            colour = TITLE_ON
        end
        rect(b[0], b[1], b[2], b[3], colour)
        text(b[0] + 8, b[1] + b[3] / 2 - 8, fit(win[W_TITLE], (b[2] - 16) / CHAR_W), WHITE_INK, 1)
    end

    draw_tray()
    let spot = clock_spot()
    text(spot[0], spot[1], time_text(false), WHITE_INK, 1)
    let off = power_button()
    let off_colour = TASKBAR_LIGHT
    if menu_open == "power" or inside_box(pointer_x, pointer_y, off) then
        off_colour = TITLE_ON
    end
    rect(off[0], off[1], off[2], off[3], off_colour)
    draw_power_sign(off[0] + off[2] / 2, off[1] + off[3] / 2 + 1, WHITE_INK)
end


# ---- the system monitor ---------------------------------------------------------------------

# Little graphics on the taskbar, next to the clock, show what aerOS is doing, from left to
# right (or in two rows, down a taskbar on the left or the right):
#     the network     signal bars, lit while the link is up. A dot in the corner says whether
#                     the card is running (green) or resting: app mode puts it away while a
#                     program that doesn't use the network runs, as the desktop doesn't
#     the processor   how busy it has been, a bar a second, the newest on the right
#     the threads     a square for each of the 16 aerOS can run, lit for the ones running
#     memory          two gauges: the memory in use, and how full the disk cache is
# Clicking them (or Home) opens a panel with more: bigger graphs and the numbers behind them.
# It is drawn again each time the desktop is, so it stays up to date while it is open, and a
# click outside it, Esc or Home closes it. menu_open is "monitor" while it is open.

func take_telemetry()
    # ask telemetry() how things are, and add a reading to each graph. How busy the processor
    # was is the share of the time since the last look that it wasn't idle
    let now = telemetry()
    if reading != nil then
        let spent = now[T_MS] - reading[T_MS]
        if spent > 0 then
            let busy = spent - (now[T_IDLE] - reading[T_IDLE])
            cpu_load = keep_between(busy * 100 / spent, 0, 100)
        end
        cpu_history[history_next] = cpu_load
        memory_history[history_next] = share(now[T_MEMORY][0], now[T_MEMORY][1])
        history_next = (history_next + 1) % HISTORY
        readings = keep_between(readings + 1, 0, HISTORY)
    end
    reading = now
end

func keep_between(n, low, high)
    # n, or low or high if it is past them
    if n < low then
        return low
    end
    if n > high then
        return high
    end
    return n
end

func share(part, total)
    # part as a percentage of total, 0 to 100 (0 when there is no total)
    if total <= 0 then
        return 0
    end
    return keep_between(part * 100 / total, 0, 100)
end

func level_colour(percent)
    # green while there is plenty left, yellow as it fills, red when it is nearly full
    if percent < 60 then
        return GOOD
    elif percent < 85 then
        return BUSY
    end
    return BAD
end

func thread_colour(state)
    # a thread's square or dot: the one running now (the desktop itself) in the theme's colour,
    # one waiting for its turn yellow, and one asleep (the disk writer, mostly) pale
    if state == "running" then
        return ACCENT
    elif state == "ready" or state == "waiting" then
        return BUSY
    elif state == "sleeping" then
        return SELECT
    end
    return FAINT
end

func size_text(kb)
    # a size in KB as "640 KB", or "12.5 MB" from a megabyte up
    if kb < 1024 then
        return str(kb) + " KB"
    end
    let tenths = kb * 10 / 1024
    return str(tenths / 10) + "." + str(tenths % 10) + " MB"
end

func duration(ms)
    # how long, as "3h 05m" or "4m 12s"
    let seconds = ms / 1000
    if seconds >= 3600 then
        return str(seconds / 3600) + "h " + two(seconds / 60 % 60) + "m"
    end
    return str(seconds / 60) + "m " + two(seconds % 60) + "s"
end

func tray_parts()
    # where each indicator goes in tray_box(): [signal, processor graph, threads, gauges], each
    # [x, y, w, h]. In a row along the taskbar, or two rows down one side (the graph below)
    let box = tray_box()
    let x = box[0]
    let y = box[1]
    if upright() then
        return [[x + 8, y + 4, 16, 18], [x + 8, y + 26, box[2] - 16, 16],
                [x + box[2] / 2 - 8, y + 5, 15, 15], [x + box[2] - 26, y + 4, 18, 18]]
    end
    return [[x + 6, y + 3, 16, 18], [x + 28, y + 3, 44, 18], [x + 78, y + 5, 15, 15], [x + 100, y + 3, 18, 18]]
end

func draw_signal(x, y, w, h, net)
    # the network as 4 signal bars, each taller than the last, in w x h. Lit while the link is
    # up; with none, dim with a red dot, and with no card at all, crossed out in red. A dot in
    # the top left (where the bars are short) is green while the card is running
    let bar_w = (w + 1) / 4
    let dim = blend(TASKBAR_LIGHT, 0xFFFFFF, 1, 5)
    let colour = dim
    if net[N_CARD] and net[N_LINK] then
        colour = LINK_UP
    end
    for i = 0 to 3 do
        let tall = (i + 1) * h / 4
        rect(x + i * bar_w, y + h - tall, bar_w - 1, tall, colour)
    end
    if not net[N_CARD] then
        line(x, y + 2, x + w - 1, y + h - 1, BAD)
        line(x + 1, y + 2, x + w, y + h - 1, BAD)
        line(x + w - 1, y + 2, x, y + h - 1, BAD)
        line(x + w, y + 2, x + 1, y + h - 1, BAD)
    elif not net[N_LINK] then
        draw_disc(x + 3, y + 3, 3, BAD)
    elif net[N_RUNNING] then
        draw_disc(x + 3, y + 3, 2, GOOD)
    end
end

func draw_graph(history, x, y, w, h, bar_w, colour)
    # a bar graph of a history ring (readings of 0 to 100) on a dark little screen: as many of
    # the newest readings as fit, bar_w pixels each, the newest on the right. Each bar is a
    # dimmer colour with a bright top, so the bars together look like a glowing line. Only the
    # readings taken so far are drawn, so a new graph fills in from the right
    rect(x, y, w, h, SCREEN_BACK)
    # lines across at a quarter, a half and three quarters (only a half on a small graph), in
    # a faint shade of the graph's colour, like the lines on an oscilloscope's screen
    let grid = blend(SCREEN_BACK, colour, 1, 7)
    if h >= 40 then
        for q = 1 to 3 do
            rect(x, y + h * q / 4, w, 1, grid)
        end
    else
        rect(x, y + h / 2, w, 1, grid)
    end
    let shown = keep_between(w / bar_w, 0, readings)
    let first_x = x + w - shown * bar_w
    let body = blend(colour, SCREEN_BACK, 2, 5)
    let gap = 1
    if bar_w <= 2 then
        gap = 0
    end
    for c = 0 to shown - 1 do
        # (the ring's oldest reading is at history_next, so the newest `shown` start that many before it)
        let value = history[(history_next - shown + c + HISTORY) % HISTORY]
        # at least the bright top, so a quiet minute is still a line along the bottom
        let tall = keep_between(value * (h - 2) / 100, 1, h - 2)
        let bx = first_x + c * bar_w
        rect(bx, y + h - 1 - tall, bar_w - gap, tall, body)
        rect(bx, y + h - 1 - tall, bar_w - gap, 1, colour)
    end
end

func draw_thread_squares(x, y, threads)
    # a 4 x 4 grid of squares, one for each thread aerOS can run: lit (thread_colour) for the
    # ones running, faint for the rest
    let unused = blend(TASKBAR_LIGHT, 0xFFFFFF, 1, 6)
    for i = 0 to THREADS_MAX - 1 do
        let colour = unused
        if i < len(threads) then
            colour = thread_colour(threads[i][1])
        end
        rect(x + (i % 4) * 4, y + (i / 4) * 4, 3, 3, colour)
    end
end

func filled(percent, room)
    # how many of `room` pixels a gauge fills for percent: at least 2 for anything above 0, so
    # a little is still seen
    if percent <= 0 then
        return 0
    end
    return keep_between(percent * room / 100, 2, room)
end

func draw_gauge(x, y, w, h, percent, colour)
    # an upright gauge, filled from the bottom, its empty part a dark shade of its colour
    rect(x, y, w, h, SCREEN_BACK)
    rect(x + 1, y + 1, w - 2, h - 2, blend(SCREEN_BACK, colour, 1, 6))
    let full = filled(percent, h - 2)
    rect(x + 1, y + h - 1 - full, w - 2, full, colour)
end

func draw_meter(x, y, w, h, percent, colour)
    # a gauge lying down, filled from the left
    rect(x, y, w, h, SCREEN_BACK)
    rect(x + 1, y + 1, w - 2, h - 2, blend(SCREEN_BACK, colour, 1, 6))
    rect(x + 1, y + 1, filled(percent, w - 2), h - 2, colour)
end

func cache_colour()
    # the disk cache's gauge: a lighter shade of the theme's title bars
    return blend(TITLE_ON, 0xFFFFFF, 2, 5)
end

func draw_tray()
    # the indicators on the taskbar (see the top of this section), lit up while the pointer is
    # on them or their panel is open
    let box = tray_box()
    if menu_open == "monitor" or inside_box(pointer_x, pointer_y, box) then
        rect(box[0], box[1], box[2], box[3], TASKBAR_LIGHT)
    end
    if reading == nil then
        return
    end
    let parts = tray_parts()
    let s = parts[0]
    draw_signal(s[0], s[1], s[2], s[3], reading[T_NET])
    let g = parts[1]
    draw_graph(cpu_history, g[0], g[1], g[2], g[3], 2, ACCENT)
    draw_thread_squares(parts[2][0], parts[2][1], reading[T_THREADS])
    let m = parts[3]
    let memory = reading[T_MEMORY]
    let used = share(memory[0], memory[1])
    draw_gauge(m[0], m[1], 7, m[3], used, level_colour(used))
    let cache = reading[T_CACHE]
    draw_gauge(m[0] + 11, m[1], 7, m[3], share(cache[0], cache[1]), cache_colour())
end

func monitor_box()
    # where the panel goes, as [x, y, w, h]: by the indicators, on the desk side of the taskbar
    let tray = tray_box()
    let w = MONITOR_W
    let h = MONITOR_H
    let x = tray[0] + tray[2] - w
    let y = BAR_Y - h - 2
    if TASKBAR_SIDE == "top" then
        y = BAR_Y + BAR_H + 2
    elif upright() then
        # beside the taskbar, its bottom level with the indicators'
        y = tray[1] + tray[3] - h
        if TASKBAR_SIDE == "left" then
            x = BAR_X + BAR_W + 2
        else
            x = BAR_X - w - 2
        end
    end
    return [keep_between(x, 2, SW - 2 - w), keep_between(y, 2, SH - 2 - h), w, h]
end

func monitor_heading(x, y, w, title, value, value_colour)
    # a heading in the panel: the title on the left, a figure on the right
    text(x, y, title, WHITE_INK, 1)
    text(x + w - len(value) * CHAR_W, y, value, value_colour, 1)
end

func draw_monitor()
    # the panel: like frosted glass, the desk showing faintly through it, with a line of the
    # theme's colour along the top. Then a part for each of the processor, memory, the disk
    # cache, the threads and the network
    let box = monitor_box()
    let x = box[0]
    let y = box[1]
    let w = box[2]
    let h = box[3]
    rect(x - 1, y - 1, w + 2, h + 2, MONITOR_EDGE)
    gtint(x, y, w, h, MENU, 0.88)
    rect(x, y, w, 3, ACCENT)
    let left = x + 18
    let wide = w - 36

    text(left, y + 14, "System monitor", ACCENT, 1)
    let up = "up " + duration(reading[T_MS])
    text(x + w - 18 - len(up) * CHAR_W, y + 14, up, SOFT_INK, 1)

    # the processor: the last minute, a bar a second
    let row = y + 44
    monitor_heading(left, row, wide, "Processor", str(cpu_load) + "% busy", ACCENT)
    draw_graph(cpu_history, left, row + 22, wide, 64, wide / HISTORY, ACCENT)
    text(left, row + 90, "a minute ago", SOFT_INK, 1)
    text(left + wide - 3 * CHAR_W, row + 90, "now", SOFT_INK, 1)

    # memory: the kernel's heap, where programs get theirs from, and its last minute as a line
    # of little bars under the meter
    row = row + 118
    let memory = reading[T_MEMORY]
    let used = share(memory[0], memory[1])
    monitor_heading(left, row, wide, "Memory", size_text(memory[0]) + " of " + size_text(memory[1]), SOFT_INK)
    draw_meter(left, row + 22, wide, 10, used, level_colour(used))
    draw_graph(memory_history, left, row + 34, wide, 12, wide / HISTORY, level_colour(used))

    # the disk cache: how full it is, and how often a read was found in it
    row = row + 60
    let cache = reading[T_CACHE]
    if cache[1] == 0 then
        monitor_heading(left, row, wide, "Disk cache", "none", SOFT_INK)
        text(left, row + 22, "No aerOS disk: files are in memory.", SOFT_INK, 1)
    else
        monitor_heading(left, row, wide, "Disk cache", size_text(cache[0]) + " of " + size_text(cache[1]), SOFT_INK)
        draw_meter(left, row + 22, wide, 10, share(cache[0], cache[1]), cache_colour())
        let found = "found in memory " + str(share(cache[2], cache[2] + cache[3])) + "%"
        text(left, row + 38, found + ", " + size_text(cache[4]) + " to write", SOFT_INK, 1)
    end

    # the threads, a row each (room for 3): a dot in the colour of what it is doing, its name,
    # and what it is doing
    row = row + 62
    let threads = reading[T_THREADS]
    let how_many = str(len(threads)) + " of " + str(THREADS_MAX)
    if len(threads) > 3 then
        how_many = "first 3 of " + how_many
    end
    monitor_heading(left, row, wide, "Threads", how_many, SOFT_INK)
    for i = 0 to keep_between(len(threads), 0, 3) - 1 do
        let ty = row + 22 + i * 18
        let doing = threads[i][1]
        draw_disc(left + 4, ty + 8, 4, thread_colour(doing))
        text(left + 16, ty, fit(threads[i][0], 20), SOFT_INK, 1)
        text(left + wide - len(doing) * CHAR_W, ty, doing, thread_colour(doing), 1)
    end

    # the network: the signal bars, bigger, and what they mean
    row = row + 84
    let net = reading[T_NET]
    let status = "connected"
    let status_colour = LINK_UP
    if not net[N_CARD] then
        status = "no card"
        status_colour = BAD
    elif not net[N_LINK] then
        status = "no link"
        status_colour = BAD
    end
    monitor_heading(left, row, wide, "Network", status, status_colour)
    draw_signal(left, row + 24, 22, 30, net)
    let lines = []
    if not net[N_CARD] then
        lines = ["aerOS found no network card", "when it started."]
    else
        let card = "The card is resting (app mode)."
        if net[N_RUNNING] then
            card = "The card is running."
        end
        if not net[N_LINK] then
            lines = ["Not plugged in: no link.", card]
        else
            lines = ["Address " + net[N_ADDRESS], card]
        end
        push(lines, "Sent " + str(net[N_SENT]) + ", received " + str(net[N_RECEIVED]) + ", blocked " + str(net[N_BLOCKED]))
        if net[N_RULES] == 0 then
            push(lines, "Firewall: no rules, all blocked")
        else
            push(lines, "Firewall: " + str(net[N_RULES]) + " rule(s)")
        end
    end
    for i = 0 to len(lines) - 1 do
        text(left + 34, row + 22 + i * 18, fit(lines[i], (wide - 34) / CHAR_W), SOFT_INK, 1)
    end

    text(left, y + h - 28, "Esc, Home or a click outside closes it", FAINT, 1)
end


# ---- the menus ------------------------------------------------------------------------------

# Two menus open from the taskbar: the start menu (every app, then the power entries and
# leaving the desktop) and the power menu (only the power entries). Each entry is
# [what it says, what it does, the app it opens or nil]

func power_entries()
    # Sleep, Restart and Shut down (see "turning off, restarting and sleeping")
    return [["Sleep", "sleep", nil], ["Restart", "restart", nil], ["Shut down", "off", nil]]
end

func menu_entries(which)
    # what the start menu ("start") or the power menu ("power") has
    if which == "power" then
        return power_entries()
    end
    let entries = []
    for app in APPS do
        push(entries, [app[1], "open", app])
    end
    for entry in power_entries() do
        push(entries, entry)
    end
    push(entries, ["Exit desktop", "exit", nil])
    return entries
end

func menu_box(which)
    # where a menu is: [x, y, w, h, rows]. Next to the button that opens it, on the desk side of
    # the taskbar, in as many columns as it takes to fit on the desk
    let count = len(menu_entries(which))
    let rows = (DESK_H - 30) / MENU_ROW
    if rows > count then
        rows = count
    end
    if rows < 1 then
        rows = 1
    end
    let columns = (count + rows - 1) / rows
    let w = columns * MENU_COLUMN
    let h = rows * MENU_ROW + 10
    let button = start_button()
    if which == "power" then
        button = power_button()
    end
    let x = button[0] - 2
    let y = BAR_Y - h - 2
    if which == "power" then
        x = button[0] + button[2] - w + 2
    end
    if TASKBAR_SIDE == "top" then
        y = BAR_Y + BAR_H + 2
    elif upright() then
        # beside the taskbar, level with the button
        y = button[1]
        if y + h > SH - 4 then
            y = SH - 4 - h
        end
        if TASKBAR_SIDE == "left" then
            x = BAR_X + BAR_W + 2
        else
            x = BAR_X - w - 2
        end
    end
    if x < 2 then
        x = 2
    end
    if x + w > SW - 2 then
        x = SW - 2 - w
    end
    return [x, y, w, h, rows]
end

func entry_spot(box, n)
    # the top left of entry n of a menu (box from menu_box): down a column, then on to the next
    return [box[0] + 2 + (n / box[4]) * MENU_COLUMN, box[1] + 5 + (n % box[4]) * MENU_ROW]
end

func entry_at(which, px, py)
    # which entry of a menu is under px, py: its number, or -1 for none
    let box = menu_box(which)
    let count = len(menu_entries(which))
    if not inside(px, py, box[0] + 2, box[1] + 5, box[2] - 2, box[3] - 5) then
        return -1
    end
    let column = (px - box[0] - 2) / MENU_COLUMN
    let row = (py - box[1] - 5) / MENU_ROW
    if row >= box[4] then
        return -1
    end
    let n = column * box[4] + row
    if n >= count then
        return -1
    end
    return n
end

func draw_menu(which)
    # a menu, over everything but the pointer
    let entries = menu_entries(which)
    let box = menu_box(which)
    rect(box[0] - 2, box[1] - 2, box[2] + 4, box[3] + 4, 0x101014)
    rect(box[0], box[1], box[2], box[3], MENU)
    let hovered = entry_at(which, pointer_x, pointer_y)
    for i = 0 to len(entries) - 1 do
        let spot = entry_spot(box, i)
        let behind = MENU
        if i == menu_choice or i == hovered then
            behind = TITLE_ON
            rect(spot[0], spot[1], MENU_COLUMN - 4, MENU_ROW, behind)
        end
        draw_icon_small(entries[i], spot[0] + 8, spot[1] + 6, behind)
        text(spot[0] + 36, spot[1] + 6, fit(entries[i][0], (MENU_COLUMN - 44) / CHAR_W), WHITE_INK, 1)
    end
end

func draw_disc(cx, cy, r, colour)
    # a filled circle, a row at a time: each row as wide as the circle is at that height
    for dy = -r to r do
        let half = floor(sqrt(r * r - dy * dy))
        rect(cx - half, cy + dy, half * 2 + 1, 1, colour)
    end
end

func draw_icon_small(entry, x, y, behind)
    # a coloured square standing for an app in the menu, or a sign for the other entries.
    # behind is the colour behind it (the moon is a disc with another of that colour over it)
    let does = entry[1]
    if does == "sleep" then
        draw_disc(x + 8, y + 8, 7, 0xC9D3F0)
        draw_disc(x + 12, y + 5, 6, behind)
        return
    elif does == "restart" or does == "off" then
        draw_power_sign(x + 8, y + 9, 0xE0E0E0)
        return
    elif does == "exit" then
        rect(x + 1, y + 1, 14, 14, 0x6F7C8A)
        return
    end
    let app = entry[2]
    let kind = app[0]
    let colour = ACCENT
    if kind == "clock" then
        colour = 0xEDEDED
    elif kind == "files" then
        colour = 0xF2C25C
    elif kind == "notes" then
        colour = 0xFFF6B3
    elif kind == "calc" then
        colour = 0x8FA0B5
    elif kind == "system" then
        colour = 0x4DA3FF
    elif kind == "settings" then
        colour = 0xBFC5CC
    elif kind == "app" then
        colour = app_colour(app)
    end
    rect(x, y, 16, 16, colour)
end

func choose(which, n)
    # entry n of a menu was picked
    let entries = menu_entries(which)
    if n < 0 or n >= len(entries) then
        return
    end
    let entry = entries[n]
    if entry[1] == "open" then
        open_app(entry[2])
    elif entry[1] == "sleep" then
        go_to_sleep()
    elif entry[1] == "restart" or entry[1] == "off" then
        power_off(entry[1])
    elif entry[1] == "exit" then
        running = false
    end
end

func draw_pointer()
    # the mouse pointer, an arrow: a white inside with a black edge, row by row
    for r = 0 to 15 do
        let width = r
        if r > 11 then
            width = 11 - (r - 11) * 2
        end
        if width > 0 then
            rect(pointer_x, pointer_y + r, width + 2, 1, 0x000000)
            rect(pointer_x + 1, pointer_y + r, width, 1, 0xFFFFFF)
        else
            rect(pointer_x, pointer_y + r, 2, 1, 0x000000)
        end
    end
end

func draw_all()
    # the whole screen, back to front, then shown at once
    draw_wallpaper()
    draw_icons()
    let top = front()
    for win in windows do
        if not win[W_SHRUNK] then
            draw_window(win, win == top)
        end
    end
    # the Browser's picture menu, if it is open, over the windows (but under the taskbar)
    wb_draw_menu(pointer_x, pointer_y)
    draw_taskbar()
    if menu_open == "monitor" then
        draw_monitor()
    elif menu_open != "" then
        draw_menu(menu_open)
    end
    draw_pointer()
    gshow()
end


# ---- The Browser window ---------------------------------------------------------------------
#
# The Browser is the browsgui package's browser (packages/browsgui.aer) in a window. Reading a
# page, laying it out and fetching it with its pictures (the "engine") is the same code, copied
# below by tools/make_desktop_browser.py: every name in it starts with wb_ or WB_. What comes
# after it is only what a window needs: drawing the browser inside the window, and the clicks and
# keys the desktop hands to it. There is one Browser. Closing its window keeps the page, and
# opening it again shows it.
#
# WB_X, WB_Y, WB_W and WB_H say where the window's inside is on the screen: wb_place sets them
# from the window before anything is drawn or clicked (a window moves when it is dragged). The
# engine lays the page out WB_W wide, which never changes, as a window has one size.
#
# Drawing is clipped by leaving things out: text() and image() draw wherever they are told. A
# line of the page is only drawn if all of it is inside the window, and the toolbar and the bars
# along the bottom are drawn after the page, over any of it that reaches under them, so nothing
# is ever drawn outside the window.

let WB_X = 0
let WB_Y = 0
let WB_W = 0
let WB_H = 0
let WB_TOOLBAR = 32              # height of the bar along the top of the window's inside
let WB_STATUS_H = 20             # and of the one along the bottom
let WB_SUGGEST_H = 22            # and of the strip above that, when a site is suggested
let wb_dragging = false          # the scroll bar's handle is being dragged
let wb_drag_offset = 0

# ==== BEGIN: copied from browsgui.aer by tools/make_desktop_browser.py, do not edit here ====
# (see "The Browser window" for what is written by hand: drawing it, the mouse and the keys)

# what the pages' &...; codes stand for. &amp; is done last, so "&amp;lt;" comes out as "&lt;"
let WB_ENTITIES = [
    ["&nbsp;", " "], ["&lt;", "<"], ["&gt;", ">"],
    ["&quot;", "\""], ["&apos;", "'"],
    ["&lsquo;", "'"], ["&rsquo;", "'"], ["&ldquo;", "\""], ["&rdquo;", "\""],
    ["&ndash;", "-"], ["&mdash;", "-"], ["&hellip;", "..."], ["&bull;", "*"], ["&middot;", "*"],
    ["&raquo;", ">>"], ["&laquo;", "<<"], ["&rarr;", "->"], ["&larr;", "<-"],
    ["&copy;", "(c)"], ["&reg;", "(R)"], ["&trade;", "(TM)"],
    ["&amp;", "&"]
]

# the tags that do something, each in a string of names with a space round each, so one
# find() says whether a tag is in it
let WB_HEADINGS = " h1 h2 h3 h4 h5 h6 "
let WB_BLOCKS = " p table pre dl figure "
let WB_BREAKS = " div tr dt dd section article header footer nav main figcaption "
let WB_BOLDS = " b strong th "
let WB_FORM_TAGS = " form button textarea select option "
let WB_INDENTED = " ul ol blockquote "
let WB_SKIPPED = " script style svg template noscript head "

let WB_SEARCH = "http://frogfind.com/?q="    # where words typed in the address bar are searched for
let WB_MAX_PAGE = 400000      # the most of a page that is read: the rest is left off
let WB_MAX_PICTURES = 8       # pictures fetched for a page
let WB_MAX_PICTURE_HEIGHT = 480

# the screen, and what is where on it
let WB_MARGIN = 16            # space left and right of the page
let WB_SB_W = 14              # width of the scroll bar
let WB_INDENT = 24            # how far a list or quote is moved in
let WB_FIELD_H = 24           # how tall a box or button on a page is
let WB_MENU_ROW = 24          # and an entry of the picture menu
# what a field is: [form, kind, name, value, label, ticked?, columns, choices, choice]. kind is
# "text", "password", "area", "checkbox", "radio", "submit", "button", "select" or "hidden"; label
# is a button's words, or what a text box says when empty; each of the choices of a select is
# [what is sent, its words]; choice is the one chosen
let WB_F_FORM = 0
let WB_F_KIND = 1
let WB_F_NAME = 2
let WB_F_VALUE = 3
let WB_F_LABEL = 4
let WB_F_ON = 5
let WB_F_COLS = 6
let WB_F_OPTIONS = 7
let WB_F_PICKED = 8

# colours (made once the graphics screen is on)
let WB_C_PAGE = 0
let WB_C_TEXT = 0
let WB_C_LINK = 0
let WB_C_HOVER = 0
let WB_C_DIM = 0
let WB_C_BAR = 0
let WB_C_BAR_TEXT = 0
let WB_C_EDGE = 0
let WB_C_BUTTON = 0
let WB_C_HANDLE = 0
let WB_C_SUGGEST = 0
let WB_C_SUGGEST_TEXT = 0

# the page being shown
let wb_address = ""           # where it came from ("" for the start page)
let wb_title = ""             # what its <title> says
let wb_atoms = []             # the page read from its HTML: words and the things between them
let wb_links = []             # the address of each link: link number n is links[n - 1]
let wb_imgs = []              # each picture: [address, alt text, its bytes or nil, width, height]
let wb_rows = []              # the page laid out: each [y, height, boxes]
let wb_page_h = 0             # how tall it all is
let wb_scroll = 0             # how far down it is shown
let wb_history = []           # the pages before it: [address, scroll]
let wb_status = ""            # a message for the bar at the bottom
let wb_hits = []              # what can be clicked on the screen now: [x, y, w, h, link number]
let wb_suggestions = []       # sites the firewall blocks, that could be allowed: [site, port, "page" or "pictures"]
let wb_retry_url = ""         # a page that wouldn't load, to be tried again once its site is allowed
let wb_retry_remember = false
let wb_hover = 0              # the link the pointer is over, or 0 (below 0: a field)
let wb_forms = []             # the forms on the page: [where it goes, its method]
let wb_fields = []            # what is in them: see F_ below
let wb_focus = -1             # the box being typed in, or -1
let wb_pic_hits = []          # where the pictures are on the screen now: [x, y, w, h, picture number]
let wb_menu = nil             # the open picture menu: [x, y, picture number, entries, w, h], or nil

# the address bar
let wb_editing = false
let wb_typed = ""
let wb_selected = false       # all of it is selected, so the next letter typed replaces it

# the pointer, and the scroll bar's handle while it is dragged

# used while the HTML is read
let wb_P_bold = 0             # how many <b>s deep
let wb_P_head = 0             # the heading level it is inside, or 0
let wb_P_link = 0             # the number of the link it is inside, or 0
let wb_P_indent = 0
let wb_P_space = false        # was there a space before the next word
let wb_in_title = false
let wb_P_form = -1            # the form it is inside, or -1
let wb_P_button = -1          # the button, text area or select whose words it is reading, or -1
let wb_P_area = -1
let wb_P_select = -1

# used while the page is laid out
let wb_L_boxes = []           # the line being built
let wb_L_words = 0
let wb_L_x = 0
let wb_L_y = 0
let wb_L_h = 0
let wb_L_left = 0
let wb_L_right = 0
let wb_L_centre = false
let wb_L_blank = true         # was there a gap just before


# ---- text ------------------------------------------------------------------------------------

func wb_replace(text, old, new)
    # every old in text swapped for new
    return join(split(text, old), new)
end

func wb_flatten(text)
    # line breaks and tabs turned into spaces (chr(13) is the carriage return Windows puts
    # before each \n)
    text = wb_replace(text, chr(13), " ")
    text = wb_replace(text, "\n", " ")
    return wb_replace(text, "\t", " ")
end

func wb_squash(text)
    # every run of spaces, tabs and line breaks turned into one space, which is what HTML does.
    # a space at the start or end is kept (as one), so "with <b>bold</b> text" still has its spaces
    text = wb_flatten(text)
    let squashed = join(split(text), " ")
    if squashed == "" then
        if text != "" then return " " end
        return ""
    end
    if text[0] == " " then squashed = " " + squashed end
    if text[len(text) - 1] == " " then squashed = squashed + " " end
    return squashed
end

func wb_plain_letters(text)
    # the punctuation that comes as UTF-8 (curly quotes, dashes, "...") turned into what the
    # screen's font has. Only looked for if a byte that starts one is there at all
    if find(text, chr(226)) != -1 then
        text = wb_replace(text, chr(226) + chr(128) + chr(152), "'")
        text = wb_replace(text, chr(226) + chr(128) + chr(153), "'")
        text = wb_replace(text, chr(226) + chr(128) + chr(156), "\"")
        text = wb_replace(text, chr(226) + chr(128) + chr(157), "\"")
        text = wb_replace(text, chr(226) + chr(128) + chr(147), "-")
        text = wb_replace(text, chr(226) + chr(128) + chr(148), "-")
        text = wb_replace(text, chr(226) + chr(128) + chr(166), "...")
        text = wb_replace(text, chr(226) + chr(128) + chr(162), "*")
        text = wb_replace(text, chr(226) + chr(134) + chr(146), "->")
    end
    if find(text, chr(194)) != -1 then
        text = wb_replace(text, chr(194) + chr(160), " ")
        text = wb_replace(text, chr(194) + chr(169), "(c)")
        text = wb_replace(text, chr(194) + chr(183), "*")
        text = wb_replace(text, chr(194) + chr(187), ">>")
    end
    return text
end

func wb_number_codes(text)
    # &#8217; and &#x2019; codes: the ones that are plain letters stay, the curly quotes and dashes
    # become the plain ones, and anything else a "?"
    let parts = split(text, "&#")
    let out = parts[0]
    for i = 1 to len(parts) - 1 do
        let part = parts[i]
        let semi = find(part, ";")
        let n = nil
        if semi > 0 and semi <= 6 then
            let digits = sub(part, 0, semi)
            if lower(digits[0]) == "x" then digits = "0" + digits end
            n = int(digits)
        end
        if n == nil then
            out = out + "&#" + part
        else
            let shown = "?"
            if n >= 32 and n < 127 then shown = chr(n) end
            if n == 8216 or n == 8217 then shown = "'" end
            if n == 8220 or n == 8221 then shown = "\"" end
            if n == 8211 or n == 8212 then shown = "-" end
            if n == 8230 then shown = "..." end
            if n == 160 then shown = " " end
            out = out + shown + sub(part, semi + 1)
        end
    end
    return out
end

func wb_decode(text)
    # the &...; codes swapped for the characters they stand for
    if find(text, "&") == -1 then return text end
    if find(text, "&#") != -1 then text = wb_number_codes(text) end
    for pair in WB_ENTITIES do
        text = wb_replace(text, pair[0], pair[1])
    end
    return text
end


# ---- addresses -------------------------------------------------------------------------------

func wb_site(url)
    # the start of an address, up to the site's name: "http://frogfind.com/read.php" gives
    # "http://frogfind.com"
    let start = find(url, "://") + 3
    let slash = find(sub(url, start), "/")
    if slash == -1 then return url end
    return sub(url, 0, start + slash)
end

func wb_host_of(url)
    # the site's name, for the fw web command: "http://site.com:8080/a" gives "site.com", and
    # port_of gives its port
    let name = sub(wb_site(url), find(url, "://") + 3)
    let colon = find(name, ":")
    if colon != -1 then name = sub(name, 0, colon) end
    return name
end

func wb_port_of(url)
    let name = sub(wb_site(url), find(url, "://") + 3)
    let colon = find(name, ":")
    if colon != -1 then return sub(name, colon + 1) end
    if sub(lower(url), 0, 8) == "https://" then return "443" end
    return "80"
end

func wb_folder(url)
    # the folder a page is in: "http://site.com/docs/a.html" gives "http://site.com/docs/"
    let question = find(url, "?")
    if question != -1 then url = sub(url, 0, question) end
    let base = wb_site(url)
    let path = sub(url, len(base))
    let last = -1
    let i = 0
    while i < len(path) do
        if path[i] == "/" then last = i end
        i = i + 1
    end
    if last == -1 then return base + "/" end
    return base + sub(path, 0, last + 1)
end

func wb_resolve(href)
    # turn a link into a whole address, using the address of the page it's on. gives back ""
    # for links that can't be followed: to the same page (#top), email, or JavaScript
    let hash = find(href, "#")
    if hash != -1 then href = sub(href, 0, hash) end
    if href == "" or wb_address == "" then
        if find(href, "://") == -1 then return "" end
    end
    let low = lower(href)
    if sub(low, 0, 7) == "mailto:" or sub(low, 0, 11) == "javascript:" or sub(low, 0, 5) == "data:" then return "" end
    if find(low, "://") != -1 then return href end
    if sub(href, 0, 2) == "//" then return sub(wb_address, 0, find(wb_address, ":") + 1) + href end
    if sub(href, 0, 1) == "/" then return wb_site(wb_address) + href end
    if sub(href, 0, 1) == "?" then
        let question = find(wb_address, "?")
        if question == -1 then return wb_address + href end
        return sub(wb_address, 0, question) + href
    end
    return wb_folder(wb_address) + href
end

func wb_address_from(text)
    # what was typed in the address bar, as an address: a site's name or address as it is (with
    # https:// put in front if there's no http:// or https://), anything else (words, or
    # something without a dot) is searched for with FrogFind
    let words = split(text)
    if len(words) == 0 then return "" end
    if len(words) == 1 and (find(words[0], ".") != -1 or find(words[0], "://") != -1 or find(words[0], "localhost") == 0) then
        if find(words[0], "://") == -1 then return "https://" + words[0] end
        return words[0]
    end
    return WB_SEARCH + join(words, "+")
end


# ---- reading the page ------------------------------------------------------------------------

func wb_tag_name(tag)
    # the tag's name in small letters: "A href=..." gives "a", "/P" gives "/p", "br/" gives "br"
    let space = find(tag, " ")
    if space != -1 then tag = sub(tag, 0, space) end
    if len(tag) > 1 and tag[len(tag) - 1] == "/" then tag = sub(tag, 0, len(tag) - 1) end
    return lower(tag)
end

func wb_attribute(tag, name)
    # one of a tag's settings: attribute("a href=\"/two.html\"", "href") gives "/two.html",
    # or "" if the tag hasn't got it
    let at = find(lower(tag), " " + name + "=")
    if at == -1 then return "" end
    let value = sub(tag, at + len(name) + 2)
    let quote = sub(value, 0, 1)
    let stop = -1
    if quote == "\"" or quote == "'" then
        value = sub(value, 1)
        stop = find(value, quote)
    else
        stop = find(value, " ")
    end
    if stop != -1 then value = sub(value, 0, stop) end
    return wb_decode(value)
end

func wb_word_size()
    # the size of letters for the words now: 2 (twice as big) in a main heading
    if wb_P_head == 1 then return 2 end
    return 1
end

func wb_word_colour()
    if wb_P_link > 0 then return WB_C_LINK end
    return WB_C_TEXT
end

func wb_add_words(text)
    # add some of the page's words: each is an atom [word, text, space before it?, size, bold?,
    # colour, link number]. A word's space is kept so "<b>bold</b>text" stays joined
    text = wb_decode(wb_squash(text))
    if wb_in_title then
        wb_title = wb_title + text
        return
    end
    # the words inside a select are its choices' labels, in a text area its text, in a button its label
    if wb_P_select >= 0 then
        let options = wb_fields[wb_P_select][WB_F_OPTIONS]
        if len(options) > 0 then
            let last = options[len(options) - 1]
            last[1] = last[1] + text
        end
        return
    end
    if wb_P_area >= 0 then
        wb_fields[wb_P_area][WB_F_VALUE] = wb_fields[wb_P_area][WB_F_VALUE] + text
        return
    end
    if wb_P_button >= 0 then
        wb_fields[wb_P_button][WB_F_LABEL] = wb_fields[wb_P_button][WB_F_LABEL] + text
        return
    end
    if text == "" then return end
    if text[0] == " " then wb_P_space = true end
    let size = wb_word_size()
    let bold = wb_P_bold > 0 or wb_P_head > 0
    let colour = wb_word_colour()
    for word in split(text) do
        push(wb_atoms, ["w", word, wb_P_space, size, bold, colour, wb_P_link])
        wb_P_space = true
    end
    wb_P_space = text[len(text) - 1] == " "
end

func wb_do_tag(tag, name, closing)
    # what each kind of tag does to the page. closing is true for the end tags, like </h1>
    let spaced = " " + name + " "
    if name == "a" then
        if closing then
            wb_P_link = 0
        else
            let url = wb_resolve(wb_attribute(tag, "href"))
            if url != "" then
                push(wb_links, url)
                wb_P_link = len(wb_links)
            end
        end
    elif name == "input" then
        wb_add_input(tag)
    elif find(WB_FORM_TAGS, spaced) != -1 then
        wb_read_form_tag(tag, name, closing)
    elif find(WB_BOLDS, spaced) != -1 then
        if closing then
            if wb_P_bold > 0 then wb_P_bold = wb_P_bold - 1 end
        else
            wb_P_bold = wb_P_bold + 1
        end
    elif find(WB_HEADINGS, spaced) != -1 then
        push(wb_atoms, ["gap"])
        if closing then
            wb_P_head = 0
        else
            wb_P_head = int(sub(name, 1))
        end
    elif name == "li" then
        if not closing then
            push(wb_atoms, ["nl"])
            push(wb_atoms, ["bul"])
        end
    elif name == "br" then
        push(wb_atoms, ["br"])
    elif name == "img" then
        let source = wb_resolve(wb_attribute(tag, "src"))
        let alt = wb_squash(wb_attribute(tag, "alt"))
        let width = int(wb_attribute(tag, "width"))
        let height = int(wb_attribute(tag, "height"))
        # one that says it is tiny is a tracking dot, not something to see
        let tiny = (width != nil and width < 4) or (height != nil and height < 4)
        if source != "" and not tiny and len(wb_imgs) < 60 then
            push(wb_imgs, [source, join(split(alt), " "), nil, 0, 0])
            push(wb_atoms, ["img", len(wb_imgs) - 1, wb_P_link])
        end
    elif name == "hr" then
        push(wb_atoms, ["rule"])
    elif name == "td" or name == "th" then
        if not closing then push(wb_atoms, ["tab"]) end
        if name == "th" then
            if closing then
                if wb_P_bold > 0 then wb_P_bold = wb_P_bold - 1 end
            else
                wb_P_bold = wb_P_bold + 1
            end
        end
    elif name == "center" then
        push(wb_atoms, ["nl"])
        if closing then push(wb_atoms, ["align", false]) else push(wb_atoms, ["align", true]) end
    elif find(WB_INDENTED, spaced) != -1 then
        push(wb_atoms, ["gap"])
        if closing then
            if wb_P_indent > 0 then wb_P_indent = wb_P_indent - 1 end
        else
            wb_P_indent = wb_P_indent + 1
        end
        push(wb_atoms, ["indent", wb_P_indent])
    elif find(WB_BLOCKS, spaced) != -1 then
        push(wb_atoms, ["gap"])
    elif find(WB_BREAKS, spaced) != -1 then
        push(wb_atoms, ["nl"])
    elif name == "title" then
        wb_in_title = not closing
    end
end

func wb_read_html(html)
    # read the HTML: fills in title, atoms, links and imgs
    wb_title = ""
    wb_atoms = []
    wb_links = []
    wb_imgs = []
    wb_P_bold = 0
    wb_P_head = 0
    wb_P_link = 0
    wb_P_indent = 0
    wb_P_space = false
    wb_in_title = false
    wb_forms = []
    wb_fields = []
    wb_focus = -1
    wb_P_form = -1
    wb_P_button = -1
    wb_P_area = -1
    wb_P_select = -1
    html = wb_plain_letters(html)

    # a plain text page has no tags: its lines are kept as they are
    if find(html, "<") == -1 then
        for text in split(wb_replace(html, chr(13), ""), "\n") do
            wb_P_space = false
            wb_add_words(text)
            push(wb_atoms, ["br"])
        end
        return
    end

    let skipping = ""      # inside <script> or <style>: the tag whose end we're waiting for
    let in_comment = false
    for piece in split(html, "<") do
        if in_comment then
            # inside <!-- ... -->: nothing counts until the end of it
            let end_at = find(piece, "-->")
            if end_at == -1 then continue end
            in_comment = false
            if skipping == "" then wb_add_words(sub(piece, end_at + 3)) end
            continue
        end
        let close = find(piece, ">")
        if close == -1 then
            # no tag here: the text before the first <, or a < that's just a <
            if skipping == "" then wb_add_words(piece) end
            continue
        end
        if sub(piece, 0, 3) == "!--" then
            let end_at = find(piece, "-->")
            if end_at == -1 then in_comment = true else wb_add_words(sub(piece, end_at + 3)) end
            continue
        end
        # tags can go over more than one line, so the line breaks in them become spaces
        let tag = wb_flatten(sub(piece, 0, close))
        let name = wb_tag_name(tag)
        let closing = false
        if sub(name, 0, 1) == "/" then
            closing = true
            name = sub(name, 1)
        end

        if skipping != "" then
            if closing and name == skipping then skipping = "" end
        elif not closing and find(WB_SKIPPED, " " + name + " ") != -1 then
            if name != "head" then skipping = name end
        else
            wb_do_tag(tag, name, closing)
        end
        if skipping == "" then wb_add_words(sub(piece, close + 1)) end
    end
end


# ---- laying the page out ---------------------------------------------------------------------

func wb_flush_line()
    # finish the line being built: centred if it should be, and put in the page
    if len(wb_L_boxes) == 0 then return end
    if wb_L_centre then
        let shift = (wb_L_right - wb_L_x) / 2
        if shift > 0 then
            for box in wb_L_boxes do
                box[0] = box[0] + shift
            end
        end
    end
    # a line with a box in it is taller than its words: they go down to its middle
    for box in wb_L_boxes do
        if box[3] == 0 and wb_L_h > box[2] then box[9] = (wb_L_h - box[2] + 4) / 2 end
    end
    push(wb_rows, [wb_L_y, wb_L_h, wb_L_boxes])
    wb_L_y = wb_L_y + wb_L_h
    wb_L_boxes = []
    wb_L_words = 0
    wb_L_x = wb_L_left
    wb_L_h = 0
    wb_L_blank = false
end

func wb_place_word(text, colour, size, bold, link, space)
    # put a word on the line, on a new line if it doesn't fit. Boxes are [x, width, height, 0,
    # text, colour, size, bold, link, how far down in a taller line, the picture it stands for or -1]
    let cell = 8 * size
    let width = len(text) * cell
    let gap = 0
    if wb_L_words > 0 and space then gap = cell end
    if wb_L_words > 0 and wb_L_x + gap + width > wb_L_right then
        wb_flush_line()
        gap = 0
    end
    # a word too long for a whole line (like a long address) is cut up
    while wb_L_x + width > wb_L_right and len(text) > 1 do
        let wb_fit = (wb_L_right - wb_L_x) / cell
        if wb_fit < 1 then wb_fit = 1 end
        if wb_fit >= len(text) then break end
        push(wb_L_boxes, [wb_L_x, wb_fit * cell, 16 * size + 4, 0, sub(text, 0, wb_fit), colour, size, bold, link, 0, -1])
        wb_L_h = 16 * size + 4
        wb_L_words = wb_L_words + 1
        wb_L_x = wb_L_right
        wb_flush_line()
        text = sub(text, wb_fit)
        width = len(text) * cell
    end
    # the space between two words of one link is part of the link: its underline carries on
    if gap > 0 and link > 0 then
        let before = wb_L_boxes[len(wb_L_boxes) - 1]
        if before[3] == 0 and before[8] == link then before[1] = before[1] + gap end
    end
    push(wb_L_boxes, [wb_L_x + gap, width, 16 * size + 4, 0, text, colour, size, bold, link, 0, -1])
    wb_L_x = wb_L_x + gap + width
    if 16 * size + 4 > wb_L_h then wb_L_h = 16 * size + 4 end
    wb_L_words = wb_L_words + 1
end

func wb_place_picture(number, link)
    # a picture goes on the line like a big word, as wide as it is (or as the page, if that is less)
    let picture = wb_imgs[number]
    if picture[2] == nil then
        # not fetched (no web rule for where it comes from, or it wasn't a picture): its name instead
        let label = "[picture]"
        if picture[1] != "" then label = "[" + picture[1] + "]" end
        if link > 0 then
            wb_place_word(label, WB_C_LINK, 1, false, link, true)
        else
            wb_place_word(label, WB_C_DIM, 1, false, link, true)
        end
        # (so it can be right-clicked like the picture)
        wb_L_boxes[len(wb_L_boxes) - 1][10] = number
        return
    end
    let width = picture[3]
    let height = picture[4]
    let room = wb_L_right - wb_L_left
    if width > room then
        height = height * room / width
        width = room
    end
    if height > WB_MAX_PICTURE_HEIGHT then
        width = width * WB_MAX_PICTURE_HEIGHT / height
        height = WB_MAX_PICTURE_HEIGHT
    end
    if width < 1 then width = 1 end
    if height < 1 then height = 1 end
    let gap = 0
    if wb_L_words > 0 then gap = 8 end
    if wb_L_words > 0 and wb_L_x + gap + width > wb_L_right then
        wb_flush_line()
        gap = 0
    end
    # [x, width, height, 1, picture number, link]
    push(wb_L_boxes, [wb_L_x + gap, width, height + 4, 1, number, link])
    wb_L_x = wb_L_x + gap + width
    if height + 4 > wb_L_h then wb_L_h = height + 4 end
    wb_L_words = wb_L_words + 1
end

func wb_layout()
    # lay the atoms out in lines that fit the screen: rows, and how tall they come to
    wb_rows = []
    wb_L_boxes = []
    wb_L_words = 0
    wb_L_left = WB_MARGIN
    wb_L_right = WB_W - WB_SB_W - WB_MARGIN
    wb_L_x = wb_L_left
    wb_L_y = 8
    wb_L_h = 0
    wb_L_centre = false
    wb_L_blank = true
    for atom in wb_atoms do
        let kind = atom[0]
        if kind == "w" then
            wb_place_word(atom[1], atom[5], atom[3], atom[4], atom[6], atom[2])
        elif kind == "img" then
            wb_place_picture(atom[1], atom[2])
        elif kind == "field" then
            wb_place_field(atom[1])
        elif kind == "nl" then
            wb_flush_line()
        elif kind == "br" then
            # a line break; on an empty line it makes a blank one
            if len(wb_L_boxes) == 0 then
                wb_L_y = wb_L_y + 16
            else
                wb_flush_line()
            end
        elif kind == "gap" then
            wb_flush_line()
            if not wb_L_blank then wb_L_y = wb_L_y + 12 end
            wb_L_blank = true
        elif kind == "bul" then
            # a bullet in the space left of the text
            wb_flush_line()
            push(wb_L_boxes, [wb_L_left - 14, 0, 20, 2, WB_C_TEXT])
            wb_L_h = 20
        elif kind == "tab" then
            if wb_L_words > 0 then wb_L_x = wb_L_x + 16 end
        elif kind == "rule" then
            wb_flush_line()
            wb_L_y = wb_L_y + 6
            push(wb_rows, [wb_L_y, 2, [[wb_L_left, wb_L_right - wb_L_left, 2, 3]]])
            wb_L_y = wb_L_y + 12
        elif kind == "indent" then
            wb_flush_line()
            wb_L_left = WB_MARGIN + atom[1] * WB_INDENT
            wb_L_x = wb_L_left
        elif kind == "align" then
            wb_flush_line()
            wb_L_centre = atom[1]
        end
    end
    wb_flush_line()
    wb_page_h = wb_L_y + 16
end


# ---- loading ---------------------------------------------------------------------------------

func wb_is_picture(data)
    # is what came back a picture rather than a page? (from the bytes it starts with)
    if len(data) < 4 then return false end
    let a = ord(data[0])
    let b = ord(data[1])
    return (a == 66 and b == 77) or (a == 137 and b == 80) or (a == 255 and b == 216) or (a == 71 and b == 73)
end

func wb_say(text)
    # put a message in the bar at the bottom, now (the next thing, like a page, may take a while)
    wb_status = text
    draw_all()
end

func wb_shows_format(url)
    # can aerOS show this kind of picture? Judged by the end of its address (before any ?): SVG,
    # WebP, AVIF and icons are drawn by nothing here, so they aren't fetched at all
    let question = find(url, "?")
    if question != -1 then url = sub(url, 0, question) end
    let dot = -1
    for i = 0 to len(url) - 1 do
        if url[i] == "." then dot = i end
    end
    if dot == -1 then return true end
    let kind = lower(sub(url, dot + 1))
    return kind != "svg" and kind != "svgz" and kind != "webp" and kind != "avif" and kind != "ico"
end

func wb_load_pictures()
    # fetch the pictures on the page (the first few that aerOS can show), one at a time, and show
    # them in their place. What stopped some is told in the bar at the bottom afterwards: most
    # often a site with no web rule (pictures usually come from another site than the page does:
    # a picture server)
    let wanted = 0
    let unshown = 0        # pictures in a format aerOS can't show
    for i = 0 to len(wb_imgs) - 1 do
        let picture = wb_imgs[i]
        if picture[2] == nil then
            if not wb_shows_format(picture[0]) then
                unshown = unshown + 1
            elif wanted < WB_MAX_PICTURES then
                wanted = wanted + 1
                wb_say("Loading picture " + wanted + ": " + picture[0])
                let data = httpget(picture[0])
                if data == nil then
                    # most likely the picture's site isn't allowed: offer to allow it
                    wb_suggest(wb_host_of(picture[0]), int(wb_port_of(picture[0])), "pictures")
                elif wb_is_picture(data) then
                    let size = imgsz(data)
                    if size != nil then
                        picture[2] = data
                        picture[3] = size[0]
                        picture[4] = size[1]
                    else
                        unshown = unshown + 1
                    end
                else
                    unshown = unshown + 1
                end
            end
        end
    end
    wb_status = ""
    if unshown > 0 then wb_status = unshown + " pictures left out: SVG, WebP and some other formats can't be shown" end
    wb_layout()
end

func wb_suggest(host, port, kind)
    # offer to allow a site the firewall blocks (a strip along the bottom: click it, or press A).
    # Not one that is allowed already, or already offered
    if fwallowed(host, port) then return end
    for each in wb_suggestions do
        if each[0] == host and each[1] == port then return end
    end
    push(wb_suggestions, [host, port, kind])
end

func wb_suggest_for_page(url)
    # a page wouldn't come: most likely its site isn't allowed. If it is, the page probably
    # moved to the other kind of address (http to https or back), whose port isn't allowed
    let host = wb_host_of(url)
    let port = int(wb_port_of(url))
    if not fwallowed(host, port) then
        wb_suggest(host, port, "page")
    elif sub(lower(url), 0, 8) == "https://" then
        wb_suggest(host, 80, "page")
    else
        wb_suggest(host, 443, "page")
    end
end

func wb_problem_with(url)
    # why a page didn't come: httpget only gives nil, so it's one of these (the get command in the
    # terminal says which)
    let message = "Couldn't load " + url + ": no such page, or the site needs fw web " + wb_host_of(url) + " " + wb_port_of(url)
    if sub(lower(url), 0, 8) == "https://" then message = message + ", or its certificate isn't good" end
    return message
end

func wb_show_page(url, page)
    # make what came back the page: a picture is a page of one picture
    wb_address = url
    wb_scroll = 0
    wb_hover = 0
    if wb_is_picture(page) then
        let size = imgsz(page)
        wb_title = url
        wb_links = []
        if size == nil then
            wb_imgs = []
            wb_atoms = [["w", "Can't show that picture: aerOS shows BMP, PNG, GIF and JPEG.", false, 1, false, WB_C_TEXT, 0]]
        else
            wb_imgs = [[url, "", page, size[0], size[1]]]
            wb_atoms = [["img", 0, 0]]
        end
        wb_layout()
        return
    end
    if len(page) > WB_MAX_PAGE then page = sub(page, 0, WB_MAX_PAGE) end
    wb_read_html(page)
    wb_layout()
end

func wb_navigate(url, remember)
    # load a new page. remember: put the page now shown in the history, for Back. True if it came
    wb_suggestions = []
    wb_menu = nil
    wb_status = "Loading " + url + "..."
    draw_all()
    let page = httpget(url)
    if page == nil then
        wb_status = wb_problem_with(url)
        wb_retry_url = url
        wb_retry_remember = remember
        wb_suggest_for_page(url)
        return false
    end
    wb_status = ""
    if remember and wb_address != "" then push(wb_history, [wb_address, wb_scroll]) end
    wb_show_page(url, page)
    draw_all()
    if len(wb_imgs) > 0 then
        wb_load_pictures()
        draw_all()
    end
    return true
end

func wb_start_page()
    # the page the browser starts on
    wb_address = ""
    wb_scroll = 0
    wb_read_html("<title>aerOS browser</title><h1>aerOS browser</h1><p>Click the address bar at the top (or press Tab), type an address or some words to search for, and press Enter.</p><h2>First, allow the site</h2><p>aerOS's firewall blocks every site until you allow it, in the terminal: <b>fw web example.com 443</b> for an https:// site, or <b>fw web example.com</b> for http://. Pictures on a page come from a site too, and only show if that is allowed as well.</p><h2>Try</h2><ul><li><a href=\"http://frogfind.com/\">FrogFind</a>: turns big modern sites into simple pages. Allow it with <b>fw web frogfind.com</b></li><li><a href=\"https://example.com/\">example.com</a> (<b>fw web example.com 443</b>)</li></ul><h2>Keys</h2><ul><li>Arrow keys, Page Up and Page Down scroll, space goes down a screen</li><li>Backspace goes back, Esc quits</li></ul>")
    wb_layout()
end


# ---- forms -----------------------------------------------------------------------------------
#
# The boxes and buttons on a page: <input> (text, search, password, checkbox, radio, buttons and
# hidden ones), <textarea> (as a line), <select> (click to go to the next choice) and <button>.
# Reading the page makes forms (the address each goes to) and fields (what is in each: see F_ above)
# and puts a ["field", number] in the page. Click a box to type in it, Enter sends the form. A form
# is sent the way a link is followed: its address with the answers on the end (?q=hello+world),
# which is what the GET method does. POST, which sends them out of sight in the request, isn't
# something aerOS's HTTP does yet.

func wb_has_flag(tag, flag)
    # does the tag have this setting with no value, like <input checked>?
    return find(lower(tag), " " + flag) != -1
end

func wb_new_field(kind, name, value, label, cols)
    # a field of the form being read (or of none: -1), and its number
    push(wb_fields, [wb_P_form, kind, name, value, label, false, cols, [], 0])
    return len(wb_fields) - 1
end

func wb_add_input(tag)
    # an <input>: its kind is its type, "text" if it doesn't say
    let kind = lower(wb_attribute(tag, "type"))
    let name = wb_attribute(tag, "name")
    let value = wb_attribute(tag, "value")
    if kind == "" then kind = "text" end
    if kind == "hidden" then
        # not drawn, but sent with the rest
        wb_new_field("hidden", name, value, "", 0)
    elif kind == "checkbox" or kind == "radio" then
        if value == "" then value = "on" end
        let number = wb_new_field(kind, name, value, "", 0)
        wb_fields[number][WB_F_ON] = wb_has_flag(tag, "checked")
        push(wb_atoms, ["field", number])
    elif kind == "submit" or kind == "button" or kind == "image" or kind == "reset" then
        let label = value
        if label == "" then label = wb_attribute(tag, "alt") end
        if label == "" and kind == "submit" then label = "Submit" end
        let shown = "submit"
        if kind == "button" or kind == "reset" then shown = "button" end
        push(wb_atoms, ["field", wb_new_field(shown, name, value, label, 0)])
    elif find(" text search email url tel number password ", " " + kind + " ") != -1 then
        let cols = int(wb_attribute(tag, "size"))
        if cols == nil or cols < 1 then cols = 20 end
        if cols > 80 then cols = 80 end
        let shown = "text"
        if kind == "password" then shown = "password" end
        push(wb_atoms, ["field", wb_new_field(shown, name, value, wb_attribute(tag, "placeholder"), cols)])
    end
end

func wb_read_form_tag(tag, name, closing)
    # <form>, <button>, <textarea>, <select> and <option>: what each starts or finishes. The words
    # inside a button, textarea or select belong to it (add_words puts them there)
    if name == "form" then
        push(wb_atoms, ["gap"])
        if closing then
            wb_P_form = -1
        else
            push(wb_forms, [wb_attribute(tag, "action"), lower(wb_attribute(tag, "method"))])
            wb_P_form = len(wb_forms) - 1
        end
    elif name == "button" then
        if closing then
            if wb_P_button >= 0 then
                let label = join(split(wb_fields[wb_P_button][WB_F_LABEL]), " ")
                if label == "" then label = "Submit" end
                wb_fields[wb_P_button][WB_F_LABEL] = label
                push(wb_atoms, ["field", wb_P_button])
                wb_P_button = -1
            end
        else
            let kind = "submit"
            if lower(wb_attribute(tag, "type")) == "button" then kind = "button" end
            wb_P_button = wb_new_field(kind, wb_attribute(tag, "name"), wb_attribute(tag, "value"), "", 0)
        end
    elif name == "textarea" then
        if closing then
            if wb_P_area >= 0 then
                wb_fields[wb_P_area][WB_F_VALUE] = join(split(wb_fields[wb_P_area][WB_F_VALUE]), " ")
                push(wb_atoms, ["field", wb_P_area])
                wb_P_area = -1
            end
        else
            let cols = int(wb_attribute(tag, "cols"))
            if cols == nil or cols < 1 then cols = 30 end
            if cols > 80 then cols = 80 end
            wb_P_area = wb_new_field("area", wb_attribute(tag, "name"), "", "", cols)
        end
    elif name == "select" then
        if closing then
            if wb_P_select >= 0 then
                # each choice's words are its label, and what is sent if it has no value of its own
                for option in wb_fields[wb_P_select][WB_F_OPTIONS] do
                    option[1] = join(split(option[1]), " ")
                    if option[0] == nil then option[0] = option[1] end
                end
                push(wb_atoms, ["field", wb_P_select])
                wb_P_select = -1
            end
        else
            wb_P_select = wb_new_field("select", wb_attribute(tag, "name"), "", "", 0)
        end
    elif name == "option" then
        if not closing and wb_P_select >= 0 then
            let value = nil
            if find(lower(tag), " value=") != -1 then value = wb_attribute(tag, "value") end
            let options = wb_fields[wb_P_select][WB_F_OPTIONS]
            push(options, [value, ""])
            if wb_has_flag(tag, "selected") then wb_fields[wb_P_select][WB_F_PICKED] = len(options) - 1 end
        end
    end
end

func wb_url_encode(text)
    # text as it goes in an address: letters and digits as they are, a space as +, anything else
    # as % and its number in hex
    if text == "" then return "" end
    let hex = "0123456789ABCDEF"
    let out = ""
    for i = 0 to len(text) - 1 do
        let c = text[i]
        let n = ord(c)
        if (n >= 48 and n <= 57) or (n >= 65 and n <= 90) or (n >= 97 and n <= 122) or c == "-" or c == "_" or c == "." or c == "~" then
            out = out + c
        elif c == " " then
            out = out + "+"
        else
            out = out + "%" + hex[n / 16] + hex[n % 16]
        end
    end
    return out
end

func wb_form_submit(form_index, button)
    # send a form: go to its address with what is in its fields on the end. button is the number of
    # the button pressed (its name and value are sent too), or -1 for Enter in a text box
    if form_index < 0 then
        wb_status = "That box isn't in a form, so there's nowhere to send it."
        return
    end
    let form = wb_forms[form_index]
    if form[1] == "post" then
        wb_status = "This form is sent with POST, which aerOS can't do yet: only forms that use GET work."
        return
    end
    # where it goes: its action (the page itself if it has none), without any ? it already has
    let base = ""
    if form[0] != "" then base = wb_resolve(form[0]) end
    if base == "" then base = wb_address end
    let question = find(base, "?")
    if question != -1 then base = sub(base, 0, question) end
    let hash = find(base, "#")
    if hash != -1 then base = sub(base, 0, hash) end

    let pairs = []
    for i = 0 to len(wb_fields) - 1 do
        let field = wb_fields[i]
        let kind = field[WB_F_KIND]
        if field[WB_F_FORM] == form_index and field[WB_F_NAME] != "" then
            let sent = nil
            if kind == "text" or kind == "password" or kind == "area" or kind == "hidden" then
                sent = field[WB_F_VALUE]
            elif (kind == "checkbox" or kind == "radio") and field[WB_F_ON] then
                sent = field[WB_F_VALUE]
            elif kind == "select" and len(field[WB_F_OPTIONS]) > 0 then
                sent = field[WB_F_OPTIONS][field[WB_F_PICKED]][0]
            elif kind == "submit" and i == button then
                sent = field[WB_F_VALUE]
            end
            if sent != nil then push(pairs, wb_url_encode(field[WB_F_NAME]) + "=" + wb_url_encode(sent)) end
        end
    end
    wb_navigate(base + "?" + join(pairs, "&"), true)
end

func wb_field_click(number)
    # a click on a field: a box is typed in, a tick box is ticked or cleared, a round one is chosen
    # (the others of its group are cleared), a button sends the form, a choice goes to the next
    let field = wb_fields[number]
    let kind = field[WB_F_KIND]
    if kind == "text" or kind == "password" or kind == "area" then
        wb_focus = number
        return
    end
    wb_focus = -1
    if kind == "checkbox" then
        field[WB_F_ON] = not field[WB_F_ON]
    elif kind == "radio" then
        for other in wb_fields do
            if other[WB_F_KIND] == "radio" and other[WB_F_FORM] == field[WB_F_FORM] and other[WB_F_NAME] == field[WB_F_NAME] then
                other[WB_F_ON] = false
            end
        end
        field[WB_F_ON] = true
    elif kind == "submit" then
        wb_form_submit(field[WB_F_FORM], number)
    elif kind == "select" then
        if len(field[WB_F_OPTIONS]) > 0 then field[WB_F_PICKED] = (field[WB_F_PICKED] + 1) % len(field[WB_F_OPTIONS]) end
    end
end

func wb_field_key(code)
    # a key, for the box being typed in. True if it used it (Enter sends the form, Esc stops typing)
    if wb_focus < 0 then return false end
    let field = wb_fields[wb_focus]
    if code == KEY_ENTER then
        # (a text area has no way to show a new line: Enter does nothing there)
        if field[WB_F_KIND] != "area" then wb_form_submit(field[WB_F_FORM], -1) end
        return true
    elif code == KEY_ESCAPE then
        wb_focus = -1
        return true
    elif code == KEY_BACKSPACE then
        if len(field[WB_F_VALUE]) > 0 then field[WB_F_VALUE] = sub(field[WB_F_VALUE], 0, len(field[WB_F_VALUE]) - 1) end
        return true
    elif code >= 32 and code < 127 then
        if len(field[WB_F_VALUE]) < 300 then field[WB_F_VALUE] = field[WB_F_VALUE] + chr(code) end
        return true
    end
    return false
end

func wb_field_width(field, room)
    # how wide a field is on the page (room is the most there is)
    let kind = field[WB_F_KIND]
    let width = 18
    if kind == "text" or kind == "password" or kind == "area" then
        width = field[WB_F_COLS] * 8 + 12
    elif kind == "submit" or kind == "button" then
        width = len(field[WB_F_LABEL]) * 8 + 24
    elif kind == "select" then
        let longest = 4
        for option in field[WB_F_OPTIONS] do
            if len(option[1]) > longest then longest = len(option[1]) end
        end
        width = longest * 8 + 36
    end
    if width > room then width = room end
    return width
end

func wb_place_field(number)
    # a field goes on the line like a word, a box 24 high. Its box is [x, width, height, 4, number]
    let field = wb_fields[number]
    let width = wb_field_width(field, wb_L_right - wb_L_left)
    let gap = 0
    if wb_L_words > 0 then gap = 8 end
    if wb_L_words > 0 and wb_L_x + gap + width > wb_L_right then
        wb_flush_line()
        gap = 0
    end
    push(wb_L_boxes, [wb_L_x + gap, width, WB_FIELD_H + 4, 4, number])
    wb_L_x = wb_L_x + gap + width
    if WB_FIELD_H + 4 > wb_L_h then wb_L_h = WB_FIELD_H + 4 end
    wb_L_words = wb_L_words + 1
end

func wb_field_disc(cx, cy, r, colour)
    # a filled circle, a row at a time (for a round choice)
    for dy = -r to r do
        let half = floor(sqrt(r * r - dy * dy))
        rect(cx - half, cy + dy, half * 2 + 1, 1, colour)
    end
end

func wb_draw_field(box, x, top)
    # one field of a line, at x on the screen (top is the line's), and the place to click on it
    let number = box[4]
    let field = wb_fields[number]
    let kind = field[WB_F_KIND]
    let width = box[1]
    let y = top + (box[2] - WB_FIELD_H) / 2
    push(wb_hits, [x, y, width, WB_FIELD_H, -(number + 1)])
    let edge = WB_C_EDGE
    if number == wb_focus then edge = WB_C_LINK end
    if kind == "text" or kind == "password" or kind == "area" or kind == "select" then
        rect(x, y, width, WB_FIELD_H, edge)
        rect(x + 1, y + 1, width - 2, WB_FIELD_H - 2, WB_C_PAGE)
        let columns = (width - 12) / 8
        let shown = field[WB_F_VALUE]
        if kind == "password" and shown != "" then shown = join(list(len(shown), "*"), "") end
        if kind == "select" then
            shown = ""
            if len(field[WB_F_OPTIONS]) > 0 then shown = field[WB_F_OPTIONS][field[WB_F_PICKED]][1] end
            columns = columns - 2
            text(x + width - 18, y + 4, "v", WB_C_DIM, 1)
        end
        if number == wb_focus then
            # the end of what was typed, and where the next letter goes
            if len(shown) > columns - 1 then shown = sub(shown, len(shown) - columns + 1) end
            text(x + 6, y + 4, shown + "_", WB_C_TEXT, 1)
        elif shown == "" then
            text(x + 6, y + 4, sub(field[WB_F_LABEL], 0, columns), WB_C_DIM, 1)
        else
            text(x + 6, y + 4, sub(shown, 0, columns), WB_C_TEXT, 1)
        end
    elif kind == "checkbox" then
        rect(x, y + 4, 16, 16, edge)
        rect(x + 1, y + 5, 14, 14, WB_C_PAGE)
        if field[WB_F_ON] then rect(x + 4, y + 8, 8, 8, WB_C_TEXT) end
    elif kind == "radio" then
        wb_field_disc(x + 8, y + 12, 8, edge)
        wb_field_disc(x + 8, y + 12, 7, WB_C_PAGE)
        if field[WB_F_ON] then wb_field_disc(x + 8, y + 12, 4, WB_C_TEXT) end
    else
        # a button
        rect(x, y, width, WB_FIELD_H, WB_C_EDGE)
        rect(x + 1, y + 1, width - 2, WB_FIELD_H - 2, WB_C_BUTTON)
        text(x + (width - len(field[WB_F_LABEL]) * 8) / 2, y + 4, sub(field[WB_F_LABEL], 0, (width - 8) / 8), WB_C_BAR_TEXT, 1)
    end
end


# ---- the picture menu ------------------------------------------------------------------------
#
# Right-click a picture (or the [name] that stands in for one that couldn't be fetched) and a menu
# opens at the pointer: Save picture (only for one that was fetched), Open picture (on a page of its
# own, like a link) and Copy address. While it is open the next click belongs to it: on an entry it
# does that, anywhere else it only closes the menu.
#
# Saving writes the picture's own bytes in the folder the program was started from. aerOS asks
# before a program changes files (Y, A or N, in a box over the screen), and file names on the disk
# are 8.3, so the file is called after the picture's (cat.jpg: "cat", then 4 hex digits worked out
# from its whole address, so two pictures of the same name don't meet, and saving one twice
# replaces it with itself) and the kind of picture it really is.

func wb_picture_at(x, y)
    # the number of the picture drawn at this place on the screen, or -1
    for hit in wb_pic_hits do
        if x >= hit[0] and x < hit[0] + hit[2] and y >= hit[1] and y < hit[1] + hit[3] then
            return hit[4]
        end
    end
    return -1
end

func wb_picture_kind(data)
    # the end of a picture's file name, from the bytes it starts with
    let a = ord(data[0])
    let b = ord(data[1])
    if a == 137 and b == 80 then return "png" end
    if a == 255 and b == 216 then return "jpg" end
    if a == 71 and b == 73 then return "gif" end
    return "bmp"
end

func wb_picture_file_name(number)
    # a file name for a picture: up to 4 letters or digits from its address's last part, 4 hex digits
    # worked out from the whole address, and its kind
    let url = wb_imgs[number][0]
    let whole = url
    let cut = find(url, "?")
    if cut != -1 then url = sub(url, 0, cut) end
    cut = find(url, "#")
    if cut != -1 then url = sub(url, 0, cut) end
    let last = ""
    for part in split(url, "/") do
        last = part
    end
    let dot = find(last, ".")
    if dot != -1 then last = sub(last, 0, dot) end
    let base = ""
    for i = 0 to len(last) - 1 do
        let n = ord(lower(last[i]))
        if len(base) < 4 and ((n >= 97 and n <= 122) or (n >= 48 and n <= 57)) then base = base + lower(last[i]) end
    end
    if base == "" then base = "pic" end
    let sum = 7
    for i = 0 to len(whole) - 1 do
        sum = (sum * 31 + ord(whole[i])) % 65521
    end
    let hex = "0123456789abcdef"
    let digits = hex[sum / 4096 % 16] + hex[sum / 256 % 16] + hex[sum / 16 % 16] + hex[sum % 16]
    return base + digits + "." + wb_picture_kind(wb_imgs[number][2])
end

func wb_save_picture(number)
    # write a fetched picture to the disk, and say where (or why not) in the status bar
    let picture = wb_imgs[number]
    if picture[2] == nil then
        wb_status = "That picture wasn't fetched, so there is nothing to save."
        return
    end
    let path = cwd() + wb_picture_file_name(number)
    if wrf(path, picture[2]) then
        wb_status = "Saved the picture as " + path
    else
        wb_status = "Couldn't save it as " + path + " (aerOS asks before a program changes files: answer Y or A)"
    end
end

func wb_menu_open_at(number, x, y, max_x, max_y)
    # open the menu for a picture with its corner at x, y (moved if it would go past max_x or max_y)
    let entries = []
    if wb_imgs[number][2] != nil then push(entries, ["Save picture", "save"]) end
    push(entries, ["Open picture", "open"])
    push(entries, ["Copy address", "copy"])
    let width = 12 * 8 + 24
    let height = len(entries) * WB_MENU_ROW + 8
    if x + width > max_x then x = max_x - width end
    if y + height > max_y then y = max_y - height end
    wb_menu = [x, y, number, entries, width, height]
end

func wb_menu_entry_at(x, y)
    # the entry of the open menu at this place, from 0, or -1
    if wb_menu == nil then return -1 end
    if x < wb_menu[0] or x >= wb_menu[0] + wb_menu[4] or y < wb_menu[1] + 4 or y >= wb_menu[1] + wb_menu[5] - 4 then return -1 end
    return (y - wb_menu[1] - 4) / WB_MENU_ROW
end

func wb_menu_pick(x, y)
    # a click while the menu is open: an entry does what it says, anywhere else only closes the menu
    let n = wb_menu_entry_at(x, y)
    if n < 0 then
        wb_menu = nil
        return
    end
    let what = wb_menu[3][n][1]
    let number = wb_menu[2]
    wb_menu = nil
    if what == "save" then
        wb_save_picture(number)
    elif what == "open" then
        wb_navigate(wb_imgs[number][0], true)
    elif what == "copy" then
        setclip(wb_imgs[number][0])
        wb_status = "Copied the picture's address."
    end
end

func wb_draw_menu(at_x, at_y)
    # the open menu, over everything, with the entry the pointer is on lit
    if wb_menu == nil then return end
    rect(wb_menu[0] - 1, wb_menu[1] - 1, wb_menu[4] + 2, wb_menu[5] + 2, WB_C_EDGE)
    rect(wb_menu[0], wb_menu[1], wb_menu[4], wb_menu[5], WB_C_PAGE)
    let lit = wb_menu_entry_at(at_x, at_y)
    for i = 0 to len(wb_menu[3]) - 1 do
        let y = wb_menu[1] + 4 + i * WB_MENU_ROW
        if i == lit then rect(wb_menu[0] + 2, y, wb_menu[4] - 4, WB_MENU_ROW, rgb(200, 220, 255)) end
        text(wb_menu[0] + 12, y + 4, wb_menu[3][i][0], WB_C_TEXT, 1)
    end
end

# ==== END: copied from browsgui.aer ====

func wb_init_colours()
    # the browser's colours (rgb needs the graphics screen to be open)
    WB_C_PAGE = rgb(255, 255, 255)
    WB_C_TEXT = rgb(30, 30, 30)
    WB_C_LINK = rgb(0, 0, 204)
    WB_C_HOVER = rgb(204, 0, 0)
    WB_C_DIM = rgb(130, 130, 130)
    WB_C_BAR = rgb(224, 224, 230)
    WB_C_BAR_TEXT = rgb(50, 50, 60)
    WB_C_EDGE = rgb(150, 150, 160)
    WB_C_BUTTON = rgb(246, 246, 250)
    WB_C_HANDLE = rgb(150, 150, 165)
    WB_C_SUGGEST = rgb(255, 240, 180)
    WB_C_SUGGEST_TEXT = rgb(80, 55, 0)
end

func wb_place(win)
    # where the Browser window's inside is on the screen now
    WB_X = win[W_X]
    WB_Y = win[W_Y] + TITLE_H
    WB_W = win[W_W]
    WB_H = win[W_H] - TITLE_H
end

func wb_window_title()
    # the window's title: Browser, and the page's own title if it has one
    let heading = wb_squash(wb_title)
    if heading == "" or heading == " " then
        return "Browser"
    end
    return "Browser - " + heading
end

func wb_bottom_height()
    # how tall what is along the bottom is: the status bar, and the suggestion above it if there is one
    if len(wb_suggestions) > 0 then
        return WB_STATUS_H + WB_SUGGEST_H
    end
    return WB_STATUS_H
end

func wb_view_height()
    # how much of the page is shown at once
    return WB_H - WB_TOOLBAR - wb_bottom_height()
end

func wb_max_scroll()
    let most = wb_page_h - wb_view_height()
    if most < 0 then
        return 0
    end
    return most
end

func wb_scroll_to(where)
    # scroll the page to this place, but not past either end
    wb_scroll = where
    if wb_scroll > wb_max_scroll() then
        wb_scroll = wb_max_scroll()
    end
    if wb_scroll < 0 then
        wb_scroll = 0
    end
end

func wb_draw_box(box, top)
    # one box of a line (top is where the line is on the screen)
    let kind = box[3]
    let x = WB_X + box[0]
    if kind == 0 then
        let colour = box[5]
        let link = box[8]
        if link > 0 and link == wb_hover then
            colour = WB_C_HOVER
        end
        let down = top + box[9]
        text(x, down, box[4], colour, box[6])
        if box[7] then
            text(x + 1, down, box[4], colour, box[6])
        end
        if link > 0 then
            rect(x, down + 16 * box[6] + 1, box[1], 1, colour)
            push(wb_hits, [x, down, box[1], box[2], link])
        end
        if box[10] >= 0 then
            push(wb_pic_hits, [x, down, box[1], box[2], box[10]])
        end
    elif kind == 1 then
        let picture = wb_imgs[box[4]]
        image(picture[2], x, top, box[1], box[2] - 4)
        if box[5] > 0 then
            push(wb_hits, [x, top, box[1], box[2], box[5]])
        end
        push(wb_pic_hits, [x, top, box[1], box[2] - 4, box[4]])
    elif kind == 2 then
        rect(x + 4, top + 8, 5, 5, box[4])
    elif kind == 4 then
        wb_draw_field(box, x, top)
    else
        rect(x, top, box[1], 1, WB_C_DIM)
        rect(x, top + 1, box[1], 1, WB_C_EDGE)
    end
end

func wb_draw_page()
    # the lines of the page that are in view
    wb_hits = []
    wb_pic_hits = []
    let page_top = WB_Y + WB_TOOLBAR
    rect(WB_X, page_top, WB_W, wb_view_height(), WB_C_PAGE)
    let bottom = wb_scroll + wb_view_height()
    for row in wb_rows do
        if row[0] >= bottom then
            break
        end
        if row[0] + row[1] > wb_scroll then
            let top = page_top + row[0] - wb_scroll
            # a line that sticks out of the window isn't drawn (see the top of this section)
            if top >= WB_Y and top + row[1] <= WB_Y + WB_H then
                for box in row[2] do
                    wb_draw_box(box, top)
                end
            end
        end
    end
end

func wb_handle()
    # where the scroll bar's handle is, as [top, height]
    let height = wb_view_height()
    let handle = height * height / wb_page_h
    if handle < 24 then
        handle = 24
    end
    return [WB_Y + WB_TOOLBAR + wb_scroll * (height - handle) / wb_max_scroll(), handle]
end

func wb_draw_scrollbar()
    # the bar down the right edge, with a handle as long as the part of the page that is shown
    let x = WB_X + WB_W - WB_SB_W
    rect(x, WB_Y + WB_TOOLBAR, WB_SB_W, wb_view_height(), WB_C_BAR)
    if wb_page_h > wb_view_height() then
        let handle = wb_handle()
        rect(x + 2, handle[0], WB_SB_W - 4, handle[1], WB_C_HANDLE)
    end
end

func wb_draw_button(x, label, width)
    # a button on the toolbar
    rect(WB_X + x, WB_Y + 4, width, 24, WB_C_EDGE)
    rect(WB_X + x + 1, WB_Y + 5, width - 2, 22, WB_C_BUTTON)
    text(WB_X + x + (width - len(label) * 8) / 2, WB_Y + 8, label, WB_C_BAR_TEXT, 1)
end

func wb_draw_toolbar()
    # the bar along the top: buttons, and the address
    rect(WB_X, WB_Y, WB_W, WB_TOOLBAR, WB_C_BAR)
    rect(WB_X, WB_Y + WB_TOOLBAR - 1, WB_W, 1, WB_C_EDGE)
    wb_draw_button(6, "Back", 56)
    wb_draw_button(68, "Reload", 64)
    wb_draw_button(138, "Home", 56)
    let x = 202
    let width = WB_W - x - 8
    rect(WB_X + x, WB_Y + 4, width, 24, WB_C_EDGE)
    rect(WB_X + x + 1, WB_Y + 5, width - 2, 22, WB_C_PAGE)
    let columns = (width - 12) / 8
    if wb_editing then
        let shown = fit(wb_typed, columns - 1)
        if wb_selected then
            rect(WB_X + x + 5, WB_Y + 7, len(shown) * 8 + 2, 18, rgb(180, 205, 255))
        end
        text(WB_X + x + 6, WB_Y + 8, shown + "_", WB_C_TEXT, 1)
    else
        let shown = wb_address
        if shown == "" then
            shown = "Type an address, or words to search for"
        end
        text(WB_X + x + 6, WB_Y + 8, fit(shown, columns), WB_C_DIM, 1)
    end
end

func wb_draw_bottom()
    # the bars along the bottom: the suggestion to allow a site (if there is one), and the status bar
    # with where the link under the pointer goes, or a message, or the title, and how far down
    let y = WB_Y + WB_H - WB_STATUS_H
    rect(WB_X, y, WB_W, WB_STATUS_H, WB_C_BAR)
    rect(WB_X, y, WB_W, 1, WB_C_EDGE)
    let words = ""
    if wb_hover > 0 and wb_hover <= len(wb_links) then
        words = wb_links[wb_hover - 1]
    elif wb_status != "" then
        words = wb_status
    else
        words = wb_squash(wb_title)
    end
    text(WB_X + 8, y + 2, fit(words, (WB_W - 16) / 8 - 6), WB_C_BAR_TEXT, 1)
    if wb_page_h > wb_view_height() then
        let percent = (wb_scroll + wb_view_height()) * 100 / wb_page_h
        if percent > 100 then
            percent = 100
        end
        let label = percent + "%"
        text(WB_X + WB_W - 8 - len(label) * 8, y + 2, label, WB_C_BAR_TEXT, 1)
    end
    if len(wb_suggestions) > 0 then
        # offering to allow a site: click it (or press A) and aerOS asks you whether to
        let up = y - WB_SUGGEST_H
        rect(WB_X, up, WB_W, WB_SUGGEST_H, WB_C_SUGGEST)
        rect(WB_X, up, WB_W, 1, WB_C_EDGE)
        let first = wb_suggestions[0]
        let reason = "so its pictures can show"
        if first[2] == "page" then
            reason = "so the page can load"
        end
        let offer = "Allow " + first[0] + " (port " + first[1] + ") " + reason + "? Click here, or press A."
        if len(wb_suggestions) > 1 then
            offer = offer + "  (" + (len(wb_suggestions) - 1) + " more sites after it)"
        end
        text(WB_X + 8, up + 3, fit(offer, (WB_W - 16) / 8), WB_C_SUGGEST_TEXT, 1)
    end
end

func wb_draw(win)
    # the Browser window's inside
    wb_place(win)
    wb_draw_page()
    wb_draw_scrollbar()
    wb_draw_toolbar()
    wb_draw_bottom()
end

func wb_link_at(x, y)
    # the number of the link at this place on the screen, or 0
    for hit in wb_hits do
        if inside(x, y, hit[0], hit[1], hit[2], hit[3]) then
            return hit[4]
        end
    end
    return 0
end

func wb_update_hover()
    # which link the pointer is over, in the Browser window when that is in front. True if that
    # changed (so the screen needs drawing again)
    let win = front()
    let over = 0
    if win != nil and win[W_KIND] == "browser" and menu_open == "" then
        wb_place(win)
        if inside(pointer_x, pointer_y, WB_X, WB_Y + WB_TOOLBAR, WB_W - WB_SB_W, wb_view_height()) then
            over = wb_link_at(pointer_x, pointer_y)
        end
    end
    if over != wb_hover then
        wb_hover = over
        return true
    end
    return false
end

func wb_right_click(px, py)
    # a click of the right button: on a picture in the Browser window in front, it opens that
    # picture's menu (anywhere else it closes the menu)
    wb_menu = nil
    let win = front()
    if win == nil or win[W_KIND] != "browser" or menu_open != "" then
        return
    end
    wb_place(win)
    if inside(px, py, WB_X, WB_Y + WB_TOOLBAR, WB_W - WB_SB_W, wb_view_height()) then
        let number = wb_picture_at(px, py)
        if number >= 0 then
            wb_menu_open_at(number, px, py, SW, DESK_Y + DESK_H)
        end
    end
end

func wb_go_back()
    # the page before this one
    if len(wb_history) == 0 then
        wb_status = "There's no page to go back to."
        return
    end
    let before = pop(wb_history)
    if wb_navigate(before[0], false) then
        wb_scroll_to(before[1])
    end
end

func wb_submit()
    # Enter in the address bar
    wb_editing = false
    let url = wb_address_from(wb_typed)
    if url != "" then
        wb_navigate(url, true)
    end
end

func wb_accept_suggestion()
    # the first suggestion was accepted: ask aerOS to allow that site. aerOS asks the person itself
    # (in a box over the screen: the browser can't answer for them) and only makes the rule if
    # they say yes, for fetching pages from that one site and port
    if len(wb_suggestions) == 0 then
        return
    end
    let first = wb_suggestions[0]
    remove(wb_suggestions, 0)
    if fwallow(first[0], first[1]) then
        wb_status = ""
        if first[2] == "page" and wb_retry_url != "" then
            wb_navigate(wb_retry_url, wb_retry_remember)
        elif len(wb_imgs) > 0 then
            wb_load_pictures()
        end
    else
        wb_status = "Not allowed: " + first[0] + " port " + first[1] + " (or the firewall is full: fw del removes a rule). Reload to be asked again."
    end
end

func wb_click(win, px, py)
    # a click inside the Browser window
    wb_place(win)
    let rx = px - WB_X
    let ry = py - WB_Y
    if ry < WB_TOOLBAR then
        wb_editing = false
        wb_focus = -1
        if rx >= 6 and rx < 62 then
            wb_go_back()
        elif rx >= 68 and rx < 132 then
            if wb_address != "" then
                wb_navigate(wb_address, false)
            end
        elif rx >= 138 and rx < 194 then
            if wb_address != "" then
                push(wb_history, [wb_address, wb_scroll])
            end
            wb_start_page()
        elif rx >= 202 then
            wb_editing = true
            wb_typed = wb_address
            wb_selected = true
        end
        return
    end
    wb_editing = false
    wb_status = ""
    if py >= WB_Y + WB_H - wb_bottom_height() then
        # along the bottom: the suggestion, if there is one (the status bar below it does nothing)
        if py < WB_Y + WB_H - WB_STATUS_H then
            wb_accept_suggestion()
        end
        return
    end
    if rx >= WB_W - WB_SB_W then
        # the scroll bar: above or below the handle a screen at a time, or take hold of the handle
        if wb_page_h > wb_view_height() then
            let handle = wb_handle()
            if py < handle[0] then
                wb_scroll_to(wb_scroll - wb_view_height() + 40)
            elif py >= handle[0] + handle[1] then
                wb_scroll_to(wb_scroll + wb_view_height() - 40)
            else
                wb_dragging = true
                wb_drag_offset = py - handle[0]
            end
        end
        return
    end
    let link = wb_link_at(px, py)
    if link > 0 then
        wb_navigate(wb_links[link - 1], true)
    elif link < 0 then
        wb_field_click(-link - 1)
    else
        wb_focus = -1
    end
end

func wb_drag_to(py)
    # the scroll bar's handle is being dragged: the page follows
    let height = wb_view_height()
    let handle = height * height / wb_page_h
    if handle < 24 then
        handle = 24
    end
    if height > handle then
        wb_scroll_to((py - wb_drag_offset - WB_Y - WB_TOOLBAR) * wb_max_scroll() / (height - handle))
    end
end

func wb_typing(win, k)
    # does the Browser window in front want this key for typing: into the address bar, or into a
    # box on the page (which takes letters, Enter, Esc and Backspace, and leaves the arrows and
    # Page Up and Down to scroll)?
    if win == nil or win[W_KIND] != "browser" then
        return false
    end
    if wb_editing then
        return true
    end
    return wb_focus >= 0 and (k == KEY_ENTER or k == KEY_ESCAPE or k == KEY_BACKSPACE or (k >= 32 and k < 127))
end

func wb_edit_key(k)
    # a key while the address is being typed, or a box on the page
    if not wb_editing then
        wb_field_key(k)
        return
    end
    if k == KEY_ENTER then
        wb_submit()
    elif k == KEY_ESCAPE then
        wb_editing = false
    elif k == KEY_BACKSPACE then
        if wb_selected then
            wb_typed = ""
        elif len(wb_typed) > 0 then
            wb_typed = sub(wb_typed, 0, len(wb_typed) - 1)
        end
        wb_selected = false
    elif k >= 32 and k < 127 then
        if wb_selected then
            wb_typed = ""
        end
        wb_selected = false
        wb_typed = wb_typed + chr(k)
    end
end

func wb_key(win, k)
    # a key for the Browser window when the address isn't being typed. True if it used it (the
    # others, like the left and right arrows, carry on as they do in any window)
    wb_place(win)
    wb_status = ""
    if k == KEY_DOWN then
        wb_scroll_to(wb_scroll + 40)
    elif k == KEY_UP then
        wb_scroll_to(wb_scroll - 40)
    elif k == KEY_PGDN or k == ord(" ") then
        wb_scroll_to(wb_scroll + wb_view_height() - 40)
    elif k == KEY_PGUP then
        wb_scroll_to(wb_scroll - wb_view_height() + 40)
    elif k == KEY_END then
        wb_scroll_to(wb_page_h)
    elif k == KEY_BACKSPACE then
        wb_go_back()
    elif k == ord("/") then
        wb_focus = -1
        wb_editing = true
        wb_typed = wb_address
        wb_selected = true
    elif (k == ord("a") or k == ord("A")) and len(wb_suggestions) > 0 then
        wb_accept_suggestion()
    else
        return false
    end
    return true
end

func open_browser()
    # open the Browser window (its page is kept from last time, or the start page, with the
    # address bar ready for typing)
    let width = DESK_W - 160
    if width > 880 then
        width = 880
    end
    let height = DESK_H - 50
    if height > 640 then
        height = 640
    end
    let win = open("browser", "Browser", width, height, [])
    wb_place(win)
    if wb_address == "" and len(wb_atoms) == 0 then
        wb_start_page()
        wb_editing = true
        wb_typed = ""
        wb_selected = false
    end
end


# ---- the mouse and the keyboard -------------------------------------------------------------

func click(px, py)
    # the left button went down at px, py: whatever is on top there gets it
    # the Browser's picture menu, if it is open, has the click first (an entry, or closing it)
    if wb_menu != nil then
        wb_menu_pick(px, py)
        return
    end
    # the system monitor's panel first, as it is drawn over everything: a click in it does
    # nothing, and anywhere else closes it (and on its indicators, that is all it does)
    if menu_open == "monitor" then
        if inside_box(px, py, monitor_box()) then
            return
        end
        menu_open = ""
        if inside_box(px, py, tray_box()) then
            return
        end
    end
    # a menu, also drawn over everything
    if menu_open != "" then
        let which = menu_open
        menu_open = ""
        let n = entry_at(which, px, py)
        if n >= 0 then
            choose(which, n)
            return
        end
        # a click anywhere else only closes the menu (unless it is on its button again)
        if which == "start" and inside_box(px, py, start_button()) then
            return
        end
        if which == "power" and inside_box(px, py, power_button()) then
            return
        end
    end

    # the taskbar: the start button, the power button, the system monitor or a window's button
    if inside(px, py, BAR_X, BAR_Y, BAR_W, BAR_H) then
        if inside_box(px, py, start_button()) then
            menu_open = "start"
            menu_choice = -1
            return
        end
        if inside_box(px, py, tray_box()) then
            menu_open = "monitor"
            return
        end
        if inside_box(px, py, power_button()) then
            menu_open = "power"
            menu_choice = -1
            return
        end
        for i = 0 to len(windows) - 1 do
            if inside_box(px, py, window_button(i)) then
                let win = windows[i]
                # clicking the front window's button shrinks it, any other brings it forward
                if win == front() then
                    win[W_SHRUNK] = true
                else
                    to_front(win)
                end
                return
            end
        end
        return
    end

    # the windows, front first
    let i = len(windows) - 1
    while i >= 0 do
        let win = windows[i]
        if not win[W_SHRUNK] and inside(px, py, win[W_X], win[W_Y], win[W_W], win[W_H]) then
            click_window(win, px, py)
            return
        end
        i = i - 1
    end

    # the icons on the desk
    for n = 0 to len(APPS) - 1 do
        let spot = icon_at(n)
        if inside(px, py, spot[0] - 10, spot[1] - 4, 68, 66) then
            open_app(APPS[n])
            return
        end
    end
end

func click_window(win, px, py)
    # a click on a window: bring it forward, then its buttons, title bar or inside
    to_front(win)
    let x = win[W_X]
    let y = win[W_Y]
    let w = win[W_W]
    if inside(px, py, x + w - BUTTON - 3, y + 3, BUTTON, BUTTON) then
        close(win)
        return
    end
    if inside(px, py, x + w - 2 * BUTTON - 6, y + 3, BUTTON, BUTTON) then
        win[W_SHRUNK] = true
        return
    end
    if py < y + TITLE_H then
        # take hold of the title bar, to drag it
        dragging = win
        drag_dx = px - x
        drag_dy = py - y
        return
    end
    let kind = win[W_KIND]
    if kind == "files" or kind == "pick" then
        let names = win[W_DATA][1]
        let top = y + TITLE_H + ROW + 6 + 5
        if names != nil and py >= top then
            let n = win[W_SCROLL] + (py - top) / ROW
            if n < len(names) then
                win[W_DATA][2] = n
                open_entry(win, names[n])
            end
        end
    elif kind == "calc" then
        let label = calc_key_at(win, px, py)
        if label != nil then
            calc_press(win, label)
        end
    elif kind == "notes" then
        if inside(px, py, x + 8, y + TITLE_H + 4, 60, ROW) then
            save_notes()
        end
    elif kind == "settings" then
        click_settings(win, px, py)
    elif kind == "browser" then
        wb_click(win, px, py)
    end
end

func scroll(win, by)
    # scroll a list window by `by` rows, keeping inside the list
    let total = 0
    let shown = rows_fit(win[W_H] - TITLE_H)
    if win[W_KIND] == "files" or win[W_KIND] == "pick" then
        if win[W_DATA][1] != nil then
            total = len(win[W_DATA][1])
        end
        shown = rows_fit(win[W_H] - TITLE_H - ROW - 6)
    elif win[W_KIND] == "view" then
        total = len(win[W_DATA])
    elif win[W_KIND] == "system" then
        total = len(system_rows) + 12
    end
    let first = win[W_SCROLL] + by
    if first > total - shown then
        first = total - shown
    end
    if first < 0 then
        first = 0
    end
    win[W_SCROLL] = first
end

func menu_key(k)
    # a key while a menu is open: Up and Down move along it, Left and Right a column across,
    # Enter picks, Esc closes it
    let count = len(menu_entries(menu_open))
    let rows = menu_box(menu_open)[4]
    if menu_choice < 0 then
        menu_choice = 0
    end
    if k == KEY_UP then
        menu_choice = (menu_choice + count - 1) % count
    elif k == KEY_DOWN then
        menu_choice = (menu_choice + 1) % count
    elif k == KEY_LEFT and menu_choice >= rows then
        menu_choice = menu_choice - rows
    elif k == KEY_RIGHT and menu_choice + rows < count then
        menu_choice = menu_choice + rows
    elif k == KEY_ENTER then
        let which = menu_open
        menu_open = ""
        choose(which, menu_choice)
    elif k == KEY_ESCAPE then
        menu_open = ""
    end
end

func press(k)
    # a key was pressed
    let top = front()
    # Esc closes the Browser's picture menu, if it is open
    if wb_menu != nil and k == KEY_ESCAPE then
        wb_menu = nil
        return
    end
    # the Browser's address bar, while it is being typed in, has every key (Tab and Esc too)
    if menu_open == "" and wb_typing(top, k) then
        wb_edit_key(k)
        return
    end
    # Tab, or a menu open: the menu has the keyboard (Notes keeps Tab for itself)
    if k == KEY_TAB and not (top != nil and top[W_KIND] == "notes" and menu_open == "") then
        if menu_open == "" then
            menu_open = "start"
        else
            menu_open = ""
        end
        menu_choice = 0
        return
    end
    # the system monitor: Esc or Home closes it. Other keys carry on as usual underneath it (the
    # arrows move the pointer, typing goes to Notes)
    if menu_open == "monitor" then
        if k == KEY_ESCAPE or k == KEY_HOME then
            menu_open = ""
            return
        end
    elif menu_open != "" then
        menu_key(k)
        return
    end
    # Home opens the system monitor
    if k == KEY_HOME then
        menu_open = "monitor"
        return
    end
    if k == KEY_ESCAPE then
        # the front window closes; with none open, the desktop ends
        if top != nil then
            close(top)
        else
            running = false
        end
        return
    end
    if top != nil and top[W_KIND] == "notes" then
        notes_key(k)
        return
    end
    if top != nil and top[W_KIND] == "calc" then
        calc_key(top, k)
        return
    end
    if top != nil and top[W_KIND] == "settings" then
        if settings_key(top, k) then
            return
        end
    end
    # the Browser: the arrows and Page Up and Down scroll, Backspace goes back
    if top != nil and top[W_KIND] == "browser" then
        if wb_key(top, k) then
            return
        end
    end
    # Files: Up and Down choose a row, Enter opens it
    if top != nil and (top[W_KIND] == "files" or top[W_KIND] == "pick") and top[W_DATA][1] != nil then
        if files_key(top, k) then
            return
        end
    end
    # the Viewer and System: the arrows scroll a line at a time
    if top != nil and (top[W_KIND] == "view" or top[W_KIND] == "system") then
        if k == KEY_UP then
            scroll(top, -1)
            return
        elif k == KEY_DOWN then
            scroll(top, 1)
            return
        end
    end
    # the lists scroll with Page Up and Page Down
    if top != nil and k == KEY_PGDN then
        scroll(top, 10)
        return
    end
    if top != nil and k == KEY_PGUP then
        scroll(top, -10)
        return
    end
    # the arrows move the pointer, and Enter clicks: for working without a mouse
    if k == KEY_LEFT then
        pointer_x = pointer_x - 12
    elif k == KEY_RIGHT then
        pointer_x = pointer_x + 12
    elif k == KEY_UP then
        pointer_y = pointer_y - 12
    elif k == KEY_DOWN then
        pointer_y = pointer_y + 12
    elif k == KEY_ENTER then
        click(pointer_x, pointer_y)
    end
    keep_pointer_on_screen()
end

func keep_pointer_on_screen()
    # the pointer stays inside the screen
    if pointer_x < 0 then
        pointer_x = 0
    end
    if pointer_y < 0 then
        pointer_y = 0
    end
    if pointer_x > SW - 1 then
        pointer_x = SW - 1
    end
    if pointer_y > SH - 1 then
        pointer_y = SH - 1
    end
end

func files_key(win, k)
    # Up, Down and Enter in Files: move the chosen row (scrolling to keep it in view), or open
    # it. True if the key was one of those
    let names = win[W_DATA][1]
    let chosen = win[W_DATA][2]
    if k == KEY_UP and chosen > 0 then
        chosen = chosen - 1
    elif k == KEY_DOWN and chosen < len(names) - 1 then
        chosen = chosen + 1
    elif k == KEY_ENTER then
        open_entry(win, names[chosen])
        return true
    elif k != KEY_UP and k != KEY_DOWN then
        return false
    end
    win[W_DATA][2] = chosen
    let shown = rows_fit(win[W_H] - TITLE_H - ROW - 6)
    if chosen < win[W_SCROLL] then
        win[W_SCROLL] = chosen
    elif chosen >= win[W_SCROLL] + shown then
        win[W_SCROLL] = chosen - shown + 1
    end
    return true
end

func follow_mouse()
    # read the mouse: move the pointer, drag a window, and click. True if anything changed
    let m = mouse()
    if m == nil then
        has_mouse = false
        return false
    end
    let changed = m[0] != mouse_x_before or m[1] != mouse_y_before or m[2] != buttons_before
    # the pointer follows the mouse only when it has moved (the arrow keys may have moved it)
    if m[0] != mouse_x_before or m[1] != mouse_y_before then
        pointer_x = m[0]
        pointer_y = m[1]
        mouse_x_before = m[0]
        mouse_y_before = m[1]
    end
    let left = m[2] % 2 == 1
    let was_left = buttons_before % 2 == 1
    let right = (m[2] / 2) % 2 == 1
    let was_right = (buttons_before / 2) % 2 == 1
    if left and not was_left then
        click(pointer_x, pointer_y)
    end
    if right and not was_right then
        wb_right_click(pointer_x, pointer_y)
    end
    if not left then
        dragging = nil
        wb_dragging = false
    end
    if wb_dragging then
        wb_drag_to(pointer_y)
        changed = true
    end
    if dragging != nil then
        # the window follows the pointer, but its title bar stays on the desk
        dragging[W_X] = pointer_x - drag_dx
        dragging[W_Y] = pointer_y - drag_dy
        keep_on_desk(dragging)
    end
    buttons_before = m[2]
    # the link under the pointer in the Browser
    if wb_update_hover() then
        changed = true
    end
    return changed
end


# ---- the desktop ----------------------------------------------------------------------------

func main()
    if not gopen() then
        print("The desktop needs a graphics screen: start aerOS from its CD (main.iso).")
        return
    end
    SW = gw()
    SH = gh()
    gbuf(true)
    wb_init_colours()
    pointer_x = SW / 2
    pointer_y = SH / 2
    NOTES_FILE = cwd() + "notes.txt"
    read_clock()
    SETTINGS_FILE = home_folder() + "desktop.cfg"
    layout()
    find_apps()

    # the windows: the ones that were open, back from an app (see "Opening an app" at the top),
    # or else the clock, to say hello
    let reopen = ["clock"]
    if len(args) > 0 and args[0] == "back" then
        reopen = []
        for i = 1 to len(args) - 1 do
            push(reopen, args[i])
        end
    end
    for kind in reopen do
        if own_kind(kind) then
            start_app(kind)
        end
    end

    # The desktop as it starts, then the settings. aerOS may ask about reading them (they are
    # in the home folder), in a box over the desktop
    take_telemetry()
    looked_at = time()
    draw_all()
    load_settings()
    move_taskbar(TASKBAR_SIDE)

    let shown_second = -1
    let needs_drawing = true
    while running do
        if follow_mouse() then
            needs_drawing = true
        end
        while haskey() and running do
            press(key())
            needs_drawing = true
        end
        # the clock (and the cursor in Notes) changes every half second
        let half = time() / 500
        if half != shown_second then
            shown_second = half
            needs_drawing = true
        end
        # the system monitor's indicators (and its panel, if it is open) take a new look each second
        if time() - looked_at >= LOOK_EVERY then
            looked_at = time()
            take_telemetry()
            needs_drawing = true
        end
        if needs_drawing and running then
            draw_all()
            needs_drawing = false
        end
        frame(30)
    end
    gclose()
    if launching != "" then
        print("Opening " + launching + ". The desktop comes back when it ends.")
    else
        print("Left the desktop.")
    end
end

main()
